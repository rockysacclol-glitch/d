undoStack = {}
curColor, curMat = "ff3b30", "Plastic"

function pushUndo(id, st)
    undoStack[#undoStack + 1] = { i = id, st = st and copy(st) or nil }
    if #undoStack > 80 then table.remove(undoStack, 1) end
end
function pushUndoGroup(ids)
    undoStack[#undoStack + 1] = { g = ids }
    if #undoStack > 80 then table.remove(undoStack, 1) end
end

function commit(st)
    if not myPlot then
        toast("Claim a plot before building", true)
        return false
    end
    if not insidePlotPart(Vector3.new(st.cf[1], st.cf[2], st.cf[3]), szOf(st), myPlot) then
        toast("You can only build inside your plot", true)
        return false
    end
    st.plot = myPlot.key
    normalize(st)
    apply(st, lp.UserId)
    queueSet(st)
    return true
end

function mine()
    local e = selected and all[selected]
    if e and e.owner == lp.UserId then return e end
end

function edit(fn, noUndo)
    local e = mine()
    if not e then
        toast("Select one of your parts first", true)
        return
    end
    local previous = copy(e.st)
    local st = copy(e.st)
    fn(st)
    if commit(st) and not noUndo then pushUndo(e.st.i, previous) end
    refreshProps()
end

function deletePart(id)
    local e = all[id]
    if not e or e.owner ~= lp.UserId then return end
    pushUndo(id, e.st)
    remove(id)
    queueDel(id)
    play("delete")
end

function spawnItem(it)
    if not myPlot then
        toast("Claim a plot before building", true)
        return
    end
    local room = CONFIG.MaxPartsPerUser - countOwned(lp.UserId)
    if room < #it.parts then
        toast("Part limit reached", true)
        return
    end
    local cam = workspace.CurrentCamera
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = lp.Character and { lp.Character } or {}
    local res = workspace:Raycast(cam.CFrame.Position, cam.CFrame.LookVector * 120, params)
    local base = res and res.Position or (cam.CFrame.Position + cam.CFrame.LookVector * 20)
    local ids = {}
    for _, p in ipairs(it.parts) do
        local off = p.off or { 0, 0, 0 }
        local rot = p.rot or { 0, 0, 0 }
        local st = {
            i = newId(), c = p.c,
            cf = { snapv(base.X + off[1], S.move), snapv(base.Y + off[2] + (p.h or p.s[2]) / 2, S.move),
                snapv(base.Z + off[3], S.move), rot[1], rot[2], rot[3] },
            s = { p.s[1], p.s[2], p.s[3] },
            col = p.col or curColor, m = p.m or curMat, t = p.t or 0,
            f = p.f and copy(p.f) or { 2, 3, 1, 1, 1, 1 },
        }
        if p.mk then
            st.mk, st.mid, st.tex, st.msc = p.mk, "", "", { 1, 1, 1 }
        end
        if p.fx then st.fx = copy(p.fx) end
        if p.dec then st.dec = copy(p.dec) end
        if p.src then st.src = p.src end
        if p.music then st.music = digits(p.music) end
        if commit(st) then ids[#ids + 1] = st.i end
    end
    if #ids == 0 then
        toast("No parts could be placed inside your plot", true)
        return
    end
    if #ids == 1 then pushUndo(ids[1], nil) else pushUndoGroup(ids) end
    select_(ids[1])
    play("place")
    if it.parts[1].mk == "FileMesh" then toast("Set a MeshId in Properties > Mesh") end
end

function pushUndoMulti(states)
    local list = {}
    for _, st in ipairs(states) do list[#list + 1] = copy(st) end
    undoStack[#undoStack + 1] = { ms = list }
    if #undoStack > 80 then table.remove(undoStack, 1) end
end

function duplicate()
    local ids = mineSelIds()
    if #ids == 0 then
        toast("Select one of your parts first", true)
        return
    end
    if #ids == 1 and not all[ids[1]].st.mdl then
        local e = all[ids[1]]
        local st = copy(e.st)
        st.i = newId()
        st.cf[1] = r3(st.cf[1] + math.max(st.s[1], S.move))
        if not commit(st) then return end
        pushUndo(st.i, nil)
        select_(st.i)
        play("place")
        return
    end
    local lo, hi = math.huge, -math.huge
    for _, id in ipairs(ids) do
        local c = all[id].st
        lo = math.min(lo, c.cf[1] - c.s[1] / 2)
        hi = math.max(hi, c.cf[1] + c.s[1] / 2)
    end
    local dx = math.max(hi - lo, S.move)
    if CONFIG.MaxPartsPerUser - countOwned(lp.UserId) < #ids then
        toast("Part limit reached", true)
        return
    end
    local modelMap, made = {}, {}
    for _, id in ipairs(ids) do
        local st = copy(all[id].st)
        st.i = newId()
        st.cf[1] = r3(st.cf[1] + dx)
        if st.mdl then
            modelMap[st.mdl] = modelMap[st.mdl] or newId()
            st.mdl = modelMap[st.mdl]
        end
        if commit(st) then made[#made + 1] = st.i end
    end
    if #made == 0 then return end
    pushUndoGroup(made)
    selectMany(made, made[1])
    play("place")
end

function deleteSelected()
    local ids = mineSelIds()
    if #ids == 0 then return end
    if #ids == 1 then
        deletePart(ids[1])
        return
    end
    local states = {}
    for _, id in ipairs(ids) do states[#states + 1] = copy(all[id].st) end
    pushUndoMulti(states)
    for _, id in ipairs(ids) do
        remove(id)
        queueDel(id)
    end
    select_(nil)
    play("delete")
end

function groupSelected()
    local ids = mineSelIds()
    if #ids < 2 then
        toast("Select two or more of your parts to group them", true)
        return
    end
    local mid, keepSrc, keepName = newId(), nil, nil
    local olds = {}
    for _, id in ipairs(ids) do
        local s = all[id].st
        olds[#olds + 1] = s
        if s.msrc and not keepSrc then keepSrc = s.msrc end
        if s.mdl and not keepName then keepName = s.mname end
    end
    for n, id in ipairs(ids) do
        local st = copy(all[id].st)
        st.mdl = mid
        st.mname = keepName or "Model"
        st.msrc = (n == 1) and keepSrc or nil
        commit(st)
    end
    pushUndoMulti(olds)
    selectMany(ids, ids[1])
    play("place")
    toast("Grouped " .. #ids .. " parts into a model")
end

function ungroupSelected()
    local ids, models, changed = mineSelIds(), {}, {}
    for _, id in ipairs(ids) do
        local m = all[id].st.mdl
        if m then models[m] = true end
    end
    if next(models) == nil then
        toast("Nothing selected is grouped", true)
        return
    end
    local olds, touched = {}, {}
    for m in pairs(models) do
        for _, e in ipairs(modelMembers(m)) do
            if e.owner == lp.UserId then
                olds[#olds + 1] = e.st
                touched[#touched + 1] = e.st.i
            end
        end
    end
    for _, id in ipairs(touched) do
        local st = copy(all[id].st)
        st.mdl, st.mname, st.msrc = nil, nil, nil
        commit(st)
    end
    pushUndoMulti(olds)
    selectMany(touched, touched[1])
    play("select")
    toast("Ungrouped")
end

function undo()
    local u = table.remove(undoStack)
    if not u then
        toast("Nothing to undo", true)
        return
    end
    if u.g then
        for _, id in ipairs(u.g) do
            remove(id)
            queueDel(id)
        end
    elseif u.ms then
        for _, st in ipairs(u.ms) do commit(copy(st)) end
    elseif u.st then
        if not commit(copy(u.st)) then
            undoStack[#undoStack + 1] = u
            return
        end
    else
        remove(u.i)
        queueDel(u.i)
    end
    refreshProps()
    play("select")
end

function clearMine()
    local ids = {}
    for id, e in pairs(all) do
        if e.owner == lp.UserId then ids[#ids + 1] = id end
    end
    for _, id in ipairs(ids) do
        remove(id)
        queueDel(id)
    end
    undoStack = {}
    play("delete")
end

-- mode "up" tilts the part about the camera's right axis (snapped to world X/Z); default spins it around Y.
-- The new state is committed instantly, but the visible part glides from where it was so you can watch it turn.
function rotateSel(deg, mode)
    local e = mine()
    local fromCF = e and e.inst.CFrame
    local axis
    if mode == "up" then
        local cam = workspace.CurrentCamera
        local r = cam and cam.CFrame.RightVector or Vector3.xAxis
        if math.abs(r.X) >= math.abs(r.Z) then
            axis = Vector3.new(r.X >= 0 and 1 or -1, 0, 0)
        else
            axis = Vector3.new(0, 0, r.Z >= 0 and 1 or -1)
        end
    end
    local multi = mineSelIds()
    if #multi > 1 then
        local lo, hi
        for _, id in ipairs(multi) do
            local p = all[id].inst.Position
            if lo then
                lo = Vector3.new(math.min(lo.X, p.X), math.min(lo.Y, p.Y), math.min(lo.Z, p.Z))
                hi = Vector3.new(math.max(hi.X, p.X), math.max(hi.Y, p.Y), math.max(hi.Z, p.Z))
            else
                lo, hi = p, p
            end
        end
        local pivot = (lo + hi) / 2
        local Rw = axis and CFrame.fromAxisAngle(axis, math.rad(deg)) or CFrame.Angles(0, math.rad(deg), 0)
        local olds = {}
        for _, id in ipairs(multi) do olds[#olds + 1] = all[id].st end
        for _, id in ipairs(multi) do
            local st = copy(all[id].st)
            st.cf = encCF(CFrame.new(pivot) * Rw * CFrame.new(-pivot) * decCF(st.cf))
            commit(st)
        end
        pushUndoMulti(olds)
        play("tick")
        refreshProps()
        return
    end
    edit(function(st)
        local cf = decCF(st.cf)
        local rot = axis and CFrame.fromAxisAngle(axis, math.rad(deg)) or CFrame.Angles(0, math.rad(deg), 0)
        st.cf = encCF(CFrame.new(cf.Position) * rot * cf.Rotation)
    end)
    local e2 = selected and all[selected]
    if e2 and fromCF then
        local goal = decCF(e2.st.cf)
        e2.inst.CFrame = fromCF
        local tw = TweenService:Create(e2.inst, TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
            { CFrame = goal })
        e2.tw = tw
        tw:Play()
    end
    play("tick")
end

do
    local FOLDERS = { saves = { "Build_saves", ".json" }, exports = { "Build_exports", ".txt" },
        premades = { "Build_premades", ".json" } }
    local mem = { saves = {}, exports = {}, premades = {} }
    local EXTRA = { "mk", "mid", "tex", "msc", "dec", "fx", "src", "music", "mdl", "mname", "msrc" }

    function Bld.clean(s)
        s = ((s or ""):gsub("[^%w%-_ ]", ""))
        s = (s:gsub("^%s+", ""):gsub("%s+$", ""))
        s = s:sub(1, 32)
        if s == "" then s = "build" end
        return s
    end

    function Bld.write(kind, name, text)
        mem[kind][name] = text
        local f = FOLDERS[kind]
        return (pcall(function()
            if not writefile then error("no writefile") end
            if makefolder and isfolder and not isfolder(f[1]) then makefolder(f[1]) end
            writefile(f[1] .. "/" .. name .. f[2], text)
        end))
    end

    function Bld.read(kind, name)
        local f = FOLDERS[kind]
        local ok, res = pcall(function()
            return readfile(f[1] .. "/" .. name .. f[2])
        end)
        if ok and type(res) == "string" then return res end
        return mem[kind][name]
    end

    function Bld.list(kind)
        local f = FOLDERS[kind]
        local set = {}
        for n in pairs(mem[kind]) do set[n] = true end
        pcall(function()
            if listfiles and isfolder and isfolder(f[1]) then
                for _, path in ipairs(listfiles(f[1])) do
                    local base = path:match("([^/\\]+)$")
                    if base and base:sub(-#f[2]) == f[2] then set[base:sub(1, -#f[2] - 1)] = true end
                end
            end
        end)
        local out = {}
        for n in pairs(set) do out[#out + 1] = n end
        table.sort(out)
        return out
    end

    function Bld.del(kind, name)
        mem[kind][name] = nil
        local f = FOLDERS[kind]
        pcall(function() delfile(f[1] .. "/" .. name .. f[2]) end)
    end

    function Bld.serialize()
        local list = {}
        for _, e in pairs(all) do
            if e.owner == lp.UserId then
                local s = e.st
                list[#list + 1] = { c = s.c, cf = s.cf, s = s.s, col = s.col, m = s.m, t = s.t, f = s.f,
                    mk = s.mk, mid = s.mid, tex = s.tex, msc = s.msc, dec = s.dec, fx = s.fx, src = s.src, music = s.music,
                    mdl = s.mdl, mname = s.mname, msrc = s.msrc }
            end
        end
        return HttpService:JSONEncode({ v = 2, p = list }), #list
    end

    -- Premades keep each part's id (and the scripts that mention those ids).
    function Bld.serializeIds(ids)
        local list = {}
        for _, id in ipairs(ids) do
            local e = all[id]
            if e then
                local s = e.st
                list[#list + 1] = { i = s.i, c = s.c, cf = s.cf, s = s.s, col = s.col, m = s.m, t = s.t, f = s.f,
                    mk = s.mk, mid = s.mid, tex = s.tex, msc = s.msc, dec = s.dec, fx = s.fx, src = s.src,
                    music = s.music, mdl = s.mdl, mname = s.mname, msrc = s.msrc }
            end
        end
        return HttpService:JSONEncode({ v = 3, premade = true, p = list }), #list
    end

    function Bld.parse(text)
        text = ((text or ""):gsub("^%s+", ""):gsub("%s+$", ""))
        if text == "" then return nil, "Nothing to import" end
        local ok, d = pcall(HttpService.JSONDecode, HttpService, text)
        if not ok or type(d) ~= "table" then return nil, "That isn't a valid build" end
        local list = d.p or d
        if type(list) ~= "table" or #list == 0 then return nil, "No parts found in that build" end
        return list
    end

    function Bld.place(list, atView, replaceExisting, keepIds)
        if not myPlot then
            toast("Claim a plot before importing", true)
            return 0
        end
        local room = CONFIG.MaxPartsPerUser - (replaceExisting and 0 or countOwned(lp.UserId))
        if room <= 0 then
            toast("Part limit reached", true)
            return 0
        end
        local sts = {}
        local renamed, usedIds, modelMap, renamedCount = {}, {}, {}, 0
        for _, p in ipairs(list) do
            if #sts >= room then break end
            if type(p) == "table" then
                local st = {
                    i = newId(), c = p.c, cf = p.cf, s = p.s,
                    col = type(p.col) == "string" and p.col:lower() or "",
                    m = type(p.m) == "string" and p.m or "Plastic",
                    t = type(p.t) == "number" and p.t or 0,
                    f = type(p.f) == "table" and p.f or { 1, 1, 1, 1, 1, 1 },
                    plot = myPlot.key,
                }
                for _, k in ipairs(EXTRA) do
                    local v = p[k]
                    if v ~= nil then st[k] = type(v) == "table" and copy(v) or v end
                end
                if keepIds and type(p.i) == "string" and #p.i >= 1 and #p.i <= 16 and p.i:match("^[%w_]+$")
                    and p.i:sub(1, 2) ~= "m_" and p.i:sub(1, 2) ~= "p_" then
                    if not all[p.i] and not usedIds[p.i] then
                        st.i = p.i
                    else
                        renamed[p.i] = st.i
                        renamedCount += 1
                    end
                end
                usedIds[st.i] = true
                if type(st.mdl) == "string" then
                    modelMap[st.mdl] = modelMap[st.mdl] or newId()
                    st.mdl = modelMap[st.mdl]
                end
                if valid(st) then
                    normalize(st)
                    sts[#sts + 1] = st
                end
            end
        end
        if #sts == 0 then
            toast("No valid parts to import", true)
            return 0
        end
        if next(renamed) then
            local function remapIds(text)
                if type(text) ~= "string" then return text end
                for old, new in pairs(renamed) do
                    text = (text:gsub("%f[%w_]" .. old .. "%f[^%w_]", new))
                end
                return text
            end
            for _, st in ipairs(sts) do
                st.src = remapIds(st.src)
                st.msrc = remapIds(st.msrc)
            end
        end
        Bld.lastRenamed = renamedCount
        if atView then
            local cam = workspace.CurrentCamera
            local minX, maxX, minZ, maxZ, minY = math.huge, -math.huge, math.huge, -math.huge, math.huge
            for _, st in ipairs(sts) do
                minX, maxX = math.min(minX, st.cf[1]), math.max(maxX, st.cf[1])
                minZ, maxZ = math.min(minZ, st.cf[3]), math.max(maxZ, st.cf[3])
                minY = math.min(minY, st.cf[2] - st.s[2] / 2)
            end
            local params = RaycastParams.new()
            params.FilterType = Enum.RaycastFilterType.Exclude
            params.FilterDescendantsInstances = lp.Character and { lp.Character } or {}
            local res = workspace:Raycast(cam.CFrame.Position, cam.CFrame.LookVector * 150, params)
            local target = res and res.Position or (cam.CFrame.Position + cam.CFrame.LookVector * 30)
            local dx, dy, dz = target.X - (minX + maxX) / 2, target.Y - minY, target.Z - (minZ + maxZ) / 2
            for _, st in ipairs(sts) do
                st.cf[1], st.cf[2], st.cf[3] = r3(st.cf[1] + dx), r3(st.cf[2] + dy), r3(st.cf[3] + dz)
            end
        end
        if replaceExisting then
            local placeable = {}
            for _, st in ipairs(sts) do
                if insidePlotPart(Vector3.new(st.cf[1], st.cf[2], st.cf[3]), szOf(st), myPlot) then
                    placeable[#placeable + 1] = st
                end
            end
            sts = placeable
            if #sts == 0 then
                toast("No imported parts fit inside your plot", true)
                return 0
            end
            clearMine()
        end
        local ids = {}
        for _, st in ipairs(sts) do
            if commit(st) then ids[#ids + 1] = st.i end
        end
        if #ids == 0 then
            toast("No imported parts fit inside your plot", true)
            return 0
        end
        pushUndoGroup(ids)
        Bld.lastIds = ids
        play("place")
        toast("Imported " .. #ids .. (#ids == 1 and " part" or " parts") .. (#ids < #list and " (some skipped)" or ""))
        return #ids
    end
end

