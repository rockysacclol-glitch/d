corner(settings, 14)
stroke(settings, C.edge, 1)
setRec = newRec(settings, Vector2.new(0, 28))
dots(settings, 14, 320, 600)

do
    local sHead = new("Frame", { Size = UDim2.new(1, 0, 0, 46), BackgroundTransparency = 1, Active = true }, settings)
    label(sHead, "Settings", { Position = UDim2.fromOffset(14, 7), Size = UDim2.new(1, -60, 0, 18),
        Font = Enum.Font.GothamBold, TextSize = 14 })
    label(sHead, "Snapping, sounds, scripts and interface", { Position = UDim2.fromOffset(14, 25),
        Size = UDim2.new(1, -60, 0, 14), TextSize = 11, TextTransparency = 0.35 })
