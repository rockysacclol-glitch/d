-- Dock World, Plots, Settings and Handbook beside the Part Editor as tabs.
do
    handbookScroll = buildHandbook(props:FindFirstChild("PropertiesBody") or props)
    -- pBody is the editor body created in buildPropertiesPanel; locate it by its named child.
    local pBody = props:FindFirstChild("PropertiesBody")
    if not pBody then
        for _, child in ipairs(props:GetChildren()) do
            if child:IsA("Frame") and child.ClipsDescendants then pBody = child break end
        end
    end
    if pBody then
        -- Create a compact tab strip and move each existing settings scroller into the same side panel.
        local tabBar = new("Frame", { Name = "SideTabs", Position = UDim2.fromOffset(8, 4),
            Size = UDim2.new(1, -16, 0, 30), BackgroundTransparency = 1 }, pBody)
        new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 4),
            SortOrder = Enum.SortOrder.LayoutOrder }, tabBar)
        local views = {}
        local function dock(sc, key)
            if not sc then return end
            sc.Parent = pBody
            sc.Position = UDim2.fromOffset(0, 36)
            sc.Size = UDim2.new(1, 0, 1, -36)
            sc.Visible = false
            views[key] = sc
        end
        local partScroll = pBody:FindFirstChildWhichIsA("ScrollingFrame")
        if partScroll then
            partScroll.Position = UDim2.fromOffset(0, 36)
            partScroll.Size = UDim2.new(1, 0, 1, -36)
            views.Part = partScroll
        end
        if worldScroll then dock(worldScroll, "World") end
        if sidePlotScroll then dock(sidePlotScroll, "Plots") end
        if sideSettingsScroll then dock(sideSettingsScroll, "Settings") end
        if handbookScroll then dock(handbookScroll, "Handbook") end
        local function chooseTab(name)
            currentSideTab = name
            for key, frame in pairs(views) do frame.Visible = key == name end
            for key, b in pairs(tabButtons) do
                setActive(b, key == name)
                local on = key == name
                b.BackgroundTransparency = on and 0 or 1
                local st = b:FindFirstChildOfClass("UIStroke")
                if st then st.Transparency = on and 0 or 1 end
            end
            refreshProps()
            if name == "Settings" and refreshSettings then refreshSettings() end
            if name == "Plots" then refreshPlotPanel() end
        end
        tabButtons = {}
        for _, name in ipairs({ "Part", "World", "Plots", "Settings", "Handbook" }) do
            local b = button(tabBar, name, function() chooseTab(name) end,
                { Size = UDim2.new(0.2, -4, 1, -4), TextSize = 11 })
            tabButtons[name] = b
        end
        openSideTab = chooseTab
        chooseTab("Part")
        -- Hide the old floating panel shells; their scroll contents now live in the side tabs.
        if worldRec and worldRec.frame then worldRec.frame.Visible = false end
        if plotRec and plotRec.frame then plotRec.frame.Visible = false end
        if setRec and setRec.frame then setRec.frame.Visible = false end
    end
end

