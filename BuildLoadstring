    local slotRow = srow(28)
    local slotBtns = {}
    local nSlots = CONFIG.Scripts.MaxPlotScripts
    for n = 1, nSlots do
        slotBtns[n] = button(slotRow, "Slot " .. n, function()
            CodeUI.idx = n
            CodeUI.load()
        end, { Size = cellW(nSlots), TextSize = 11 })
    end

    local _, nameBox = field(srow(28), "", UDim2.new(1, 0, 1, 0), nil)
