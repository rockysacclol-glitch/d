function makeInst(class)
    local p
    if class == "Wedge" then
        p = Instance.new("WedgePart")
    elseif class == "Corner" then
        p = Instance.new("CornerWedgePart")
    elseif class == "Truss" then
        p = Instance.new("TrussPart")
    else
        p = Instance.new("Part")
        p.Shape = class == "Ball" and Enum.PartType.Ball or class == "Cylinder" and Enum.PartType.Cylinder
            or Enum.PartType.Block
    end
    return p
end

function szOf(st)
    return Vector3.new(math.clamp(st.s[1], 0.05, 2048), math.clamp(st.s[2], 0.05, 2048),
        math.clamp(st.s[3], 0.05, 2048))
end

function buildKids(p, st)
    for _, c in ipairs(p:GetChildren()) do
        if c:GetAttribute("NBX") then c:Destroy() end
    end
    local function mark(i)
        i:SetAttribute("NBX", true)
        i.Parent = p
        return i
    end
    if st.c == "Mesh" then
        local sm = Instance.new("SpecialMesh")
        local ok = true
        if st.mk == "FileMesh" then
            if st.mid ~= "" then
                sm.MeshType = Enum.MeshType.FileMesh
                sm.MeshId = "rbxassetid://" .. st.mid
            else
                ok = false
            end
        else
            sm.MeshType = Enum.MeshType[st.mk]
        end
        if ok then
            if st.tex and st.tex ~= "" then sm.TextureId = "rbxassetid://" .. st.tex end
            sm.Scale = Vector3.new(st.msc[1], st.msc[2], st.msc[3])
            mark(sm)
        else
            sm:Destroy()
        end
    end
    for _, d in ipairs(st.dec or {}) do
        local x = Instance.new(d.k == "t" and "Texture" or "Decal")
        x.Face = Enum.NormalId[FACES[d.f]]
        if d.id ~= "" then x.Texture = "rbxassetid://" .. d.id end
        x.Transparency = d.tr
        if d.k == "t" then
            x.StudsPerTileU = 4
            x.StudsPerTileV = 4
        end
        mark(x)
    end
    for _, f in ipairs(st.fx or {}) do
        local col = hex2c(f.c)
        local k = f.k
        if k == "Fire" then
            local x = Instance.new("Fire")
            x.Color = col
            x.SecondaryColor = Color3.new(col.R * 0.6, col.G * 0.3, col.B * 0.2)
            x.Size = f.a
            x.Heat = f.b
            mark(x)
        elseif k == "Smoke" then
            local x = Instance.new("Smoke")
            x.Color = col
            x.Size = f.a
            x.RiseVelocity = f.b
            x.Opacity = 0.5
            mark(x)
        elseif k == "Sparkles" then
            local x = Instance.new("Sparkles")
            x.SparkleColor = col
            mark(x)
        elseif k == "PointLight" then
            local x = Instance.new("PointLight")
            x.Color = col
            x.Brightness = f.a
            x.Range = f.b
            mark(x)
        elseif k == "SpotLight" then
            local x = Instance.new("SpotLight")
            x.Color = col
            x.Brightness = f.a
            x.Range = f.b
            x.Angle = 80
            x.Face = Enum.NormalId.Front
            mark(x)
        elseif k == "Particles" then
            local x = Instance.new("ParticleEmitter")
            x.Color = ColorSequence.new(col)
            x.Rate = f.a
            x.Speed = NumberRange.new(f.b * 0.7, f.b)
            x.Lifetime = NumberRange.new(1, 2.5)
            x.Size = NumberSequence.new(0.6, 0)
            x.LightEmission = 0.5
            x.SpreadAngle = Vector2.new(20, 20)
            if f.id ~= "" then x.Texture = "rbxassetid://" .. f.id end
            mark(x)
        elseif k == "Highlight" then
            local x = Instance.new("Highlight")
            x.Adornee = p
            x.FillColor = col
            x.OutlineColor = col
            x.FillTransparency = 1 - f.a
            x.OutlineTransparency = f.b
            mark(x)
        end
    end
    if st.music and st.music ~= "" then
        local ids = {}
        for token in st.music:gmatch("%d+") do
            if #token <= 15 and #ids < 8 then ids[#ids + 1] = token end
        end
        if #ids > 0 then
            local sound = Instance.new("Sound")
            sound.Name = "BuildPartMusic"
            sound.SoundId = "rbxassetid://" .. ids[1]
            sound.Volume = 0.5
            sound.Looped = #ids == 1
            sound.RollOffMode = Enum.RollOffMode.InverseTapered
            sound.RollOffMinDistance = 8
            sound.RollOffMaxDistance = 90
            sound.EmitterSize = 5
            local reverb = Instance.new("ReverbSoundEffect")
            reverb.DecayTime = 1.6
            reverb.Density = 0.75
            reverb.Diffusion = 0.8
            reverb.DryLevel = 0
            reverb.WetLevel = -8
            reverb.Parent = sound
            local echo = Instance.new("EchoSoundEffect")
            echo.Delay = 0.12
            echo.Feedback = 0.12
            echo.DryLevel = 0
            echo.WetLevel = -12
            echo.Parent = sound
            sound:SetAttribute("BuildMusicIndex", 1)
            mark(sound)
            sound.Ended:Connect(function()
                if sound.Parent ~= p or not running then return end
                local index = (sound:GetAttribute("BuildMusicIndex") or 1) % #ids + 1
                sound:SetAttribute("BuildMusicIndex", index)
                sound.SoundId = "rbxassetid://" .. ids[index]
                sound.TimePosition = 0
                sound:Play()
            end)
            task.defer(function()
                if sound.Parent == p then
                    pcall(stopDefaultThemes)
                    pcall(function() sound:Play() end)
                end
            end)
        end
    end

end

function sigOf(st)
    return HttpService:JSONEncode({ c = st.c, mk = st.mk, mid = st.mid, tex = st.tex, msc = st.msc, dec = st.dec, fx = st.fx, music = st.music })
end

POP = TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
function apply(st, owner)
    local e = all[st.i]
    if e and e.st.c ~= st.c then
        if e.tw then e.tw:Cancel() end
        e.inst:Destroy()
        e = nil
    end
    if e and e.tw then e.tw:Cancel() end
    local isNew = e == nil
    local p = e and e.inst or makeInst(st.c)
    local target = szOf(st)
    p.Anchored = true
    p.Name = st.i
    p.CFrame = decCF(st.cf)
    p.Color = hex2c(st.col)
    p.Material = MATENUM[st.m] or Enum.Material.Plastic
    for k, face in ipairs(FACES) do
        p[face .. "Surface"] = SURFENUM[st.f[k]] or Enum.SurfaceType.Smooth
    end
    p:SetAttribute("NB", st.i)
    local finalT = math.clamp(st.t, 0, 1)
    local tw
    if isNew and (popEnabled or owner == lp.UserId) then
        p.Size = Vector3.new(math.max(0.05, target.X * 0.35), math.max(0.05, target.Y * 0.35),
            math.max(0.05, target.Z * 0.35))
        p.Transparency = 1
        p.Parent = folder
        tw = TweenService:Create(p, POP, { Size = target, Transparency = finalT })
        tw:Play()
    else
        p.Size = target
        p.Transparency = finalT
        p.Parent = folder
    end
    local sig = sigOf(st)
    if isNew or e.sig ~= sig then buildKids(p, st) end
    all[st.i] = { st = copy(st), inst = p, owner = owner, tw = tw, sig = sig,
        paused = e and e.paused, approved = e and e.approved }
    if selected == st.i then
        selBox.Adornee = p
        if isNew and updateHandles then updateHandles() end
    end
    if st.mdl then modelTouched[st.mdl] = os.clock() end
    Scripts.sync(st.i)
end

function remove(id)
    if msel[id] then
        msel[id] = nil
        task.defer(refreshMultiBoxes)
    end
    local e = all[id]
    if e then
        Scripts.stop(id, nil, true)
        Scripts.logs[id], Scripts.errs[id] = nil, nil
        all[id] = nil
        if e.tw then e.tw:Cancel() end
        local inst = e.inst
        inst.CanQuery = false
        pcall(function()
            TweenService:Create(inst, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
                { Size = Vector3.new(0.05, 0.05, 0.05), Transparency = 1 }):Play()
        end)
        task.delay(0.22, function() inst:Destroy() end)
    end
    if selected == id then select_(nil) end
end

plots, plotWorldSettings, acceptPlot, removeOwnerPlots, insidePlot, insidePlotPart = nil, nil, nil, nil, nil, nil
queueSet, queueDel, publish, startNetwork, countOwned, closeWS = nil, nil, nil, nil, nil, nil
do
    local queue = {}
    local lastId, wsRef
    local lastWarn = 0

    queueSet = function(st)
        local op = copy(st)
        op.k = "s"
        if (op.src or op.msrc) and #HttpService:JSONEncode(op) > 3600 then
            op.msrc = nil
            if op.src and #HttpService:JSONEncode(op) > 3600 then op.src = nil end
            if os.clock() - lastWarn > 6 then
                lastWarn = os.clock()
                toast("Part too big to share the script - it runs on your screen only", true)
            end
        end
        queue[st.i] = op
    end
    queueDel = function(id) queue[id] = { k = "d", i = id } end

    publish = function(obj)
        local body = HttpService:JSONEncode(obj)
        task.spawn(function()
            pcall(httpReq, {
                Url = baseUrl .. "/" .. topic,
                Method = "POST",
                Headers = { ["Content-Type"] = "text/plain" },
                Body = body,
            })
        end)
    end

    local function flush()
        if next(queue) == nil then return end
        local ops = queue
        queue = {}
        local chunk, size, sent = {}, 0, 0
        for id, op in pairs(ops) do
            if sent >= CONFIG.MaxChunksPerFlush then
                if queue[id] == nil then queue[id] = op end
            else
                local len = #HttpService:JSONEncode(op) + 1
                if size + len > 3300 and #chunk > 0 then
                    publish({ u = lp.UserId, n = lp.Name, o = chunk })
                    sent += 1
                    chunk, size = {}, 0
                end
                chunk[#chunk + 1] = op
                size = size + len
            end
        end
        if #chunk > 0 then publish({ u = lp.UserId, n = lp.Name, o = chunk }) end
    end

    countOwned = function(u)
        local n = 0
        for _, e in pairs(all) do if e.owner == u then n += 1 end end
        return n
    end

    local function onMessage(text)
        local ok, d = pcall(HttpService.JSONDecode, HttpService, text)
        if not ok or type(d) ~= "table" or type(d.o) ~= "table" then return end
        local u = d.u
        if type(u) ~= "number" or u == lp.UserId then return end
        peers[u] = type(d.n) == "string" and d.n:sub(1, 30) or tostring(u)
        local count = countOwned(u)
        for _, op in ipairs(d.o) do
            if type(op) == "table" then
                if op.k == "s" and valid(op) then
                    local plot = plots[op.plot]
                    if not plot or plot.owner ~= u or not insidePlotPart(Vector3.new(op.cf[1], op.cf[2], op.cf[3]),
                        szOf(op), plot) then
                        continue
                    end
                    normalize(op)
                    local ex = all[op.i]
                    if ex and ex.owner ~= u then
                    elseif ex or count < CONFIG.MaxPartsPerUser then
                        if not ex then count += 1 end
                        pcall(apply, op, u)
                    end
                elseif op.k == "d" and type(op.i) == "string" then
                    local ex = all[op.i]
                    if ex and ex.owner == u then remove(op.i) end
                elseif op.k == "pc" and type(op.p) == "table" then
                    op.p.owner = u
                    op.p.name = d.n or tostring(u)
                    acceptPlot(op.p)
                elseif op.k == "pw" and type(op.plot) == "string" and type(op.settings) == "table" then
                    local plot = plots[op.plot]
                    if plot and plot.owner == u then
                        plotWorldSettings[op.plot] = op.settings
                        if activePlot == op.plot then applyPlotWorld(op.plot) end
                    end
                elseif op.k == "ps" and type(op.plot) == "string" and type(op.idx) == "number" then
                    local plot = plots[op.plot]
                    if plot and plot.owner == u then
                        pcall(setPlotScript, op.plot, op.idx, op.n, op.src, false)
                    end
                elseif op.k == "x" then
                    local removeIds = {}
                    for id, e in pairs(all) do
                        if e.owner == u then removeIds[#removeIds + 1] = id end
                    end
                    for _, id in ipairs(removeIds) do remove(id) end
                    removeOwnerPlots(u)
                    peers[u] = nil
                end
            end
        end
    end

    local function handleLine(line)
        local ok, ev = pcall(HttpService.JSONDecode, HttpService, line)
        if not ok or type(ev) ~= "table" then return end
        if ev.event == "message" and type(ev.message) == "string" then
            if ev.id then lastId = ev.id end
            pcall(onMessage, ev.message)
        end
    end

    closeWS = function()
        if wsRef then wsRef:Close() end
    end

    startNetwork = function()
        task.spawn(function()
            while running do
                local gotWS = false
                if WSconnect then
                    local url = wsBase .. "/" .. topic .. "/ws?since=" .. (lastId or CONFIG.History)
                    local ok, ws = pcall(WSconnect, url)
                    if ok and ws then
                        gotWS = true
                        wsRef = ws
                        setStatus("live", "ok")
                        local closed = false
                        ws.OnMessage:Connect(handleLine)
                        ws.OnClose:Connect(function() closed = true end)
                        while running and not closed do task.wait(0.5) end
                        pcall(function() ws:Close() end)
                        wsRef = nil
                        if running then setStatus("reconnecting", "warn") end
                        task.wait(2)
                    end
                end
                if not gotWS and running then
                    local ok, r = pcall(httpReq, {
                        Url = baseUrl .. "/" .. topic .. "/json?poll=1&since=" .. (lastId or CONFIG.History),
                        Method = "GET",
                    })
                    if ok and type(r) == "table" and r.Body then
                        for line in r.Body:gmatch("[^\r\n]+") do handleLine(line) end
                        setStatus("live (polling)", "ok")
                    else
                        setStatus("offline", "bad")
                    end
                    task.wait(CONFIG.PollInterval)
                end
            end
        end)
        task.spawn(function()
            while running do
                task.wait(CONFIG.FlushInterval)
                flush()
            end
        end)
    end
end

plots = {}
plotWorldSettings = {}
myPlot = nil
plotFolder = Instance.new("Folder")
plotFolder.Name = "BuildPlots"
plotFolder.Parent = workspace
plotVisuals = {}

function plotKey(owner) return "P_" .. tostring(owner) end

function plotCenter(plot)
    return Vector3.new(plot.x or 0, 0, plot.z or 0)
end

function plotsOverlap(a, b)
    local span = CONFIG.Plots.HalfSize * 2
    return math.abs(a.x - b.x) < span and math.abs(a.z - b.z) < span
end

insidePlot = function(position, plot)
    if typeof(position) ~= "Vector3" or type(plot) ~= "table" then return false end
    local center = plotCenter(plot)
    local radius = CONFIG.Plots.HalfSize
    return math.abs(position.X - center.X) <= radius and math.abs(position.Z - center.Z) <= radius
end

insidePlotPart = function(position, size, plot)
    if not insidePlot(position, plot) or typeof(size) ~= "Vector3" then return false end
    local center = plotCenter(plot)
    local radius = CONFIG.Plots.HalfSize
    return math.abs(position.X - center.X) + size.X / 2 <= radius
        and math.abs(position.Z - center.Z) + size.Z / 2 <= radius
end

function playerPosition()
    local character = lp.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    return root and root.Position or nil
end

function isPlayerInPlot(key)
    local plot = plots[key]
    local position = playerPosition()
    return plot ~= nil and position ~= nil and insidePlot(position, plot)
end

function activePlotAt(position)
    if not position then return nil end
    for key, plot in pairs(plots) do
        if insidePlot(position, plot) then return key, plot end
    end
    return nil
end

-- Builds the plot's boundary (a SelectionBox around an invisible area part) and, for baseplate plots, the plate.
function updatePlotVisual(key, plot)
    local old = plotVisuals[key]
    if old then old:Destroy() end
    plotVisuals[key], plotAreas[key] = nil, nil
    local H = CONFIG.Plots.HalfSize
    local tall = CONFIG.Plots.AreaHeight
    local y = plot.y or 0
    local own = plot.owner == lp.UserId

    local f = Instance.new("Folder")
    f.Name = "BuildPlot_" .. key

    local area = Instance.new("Part")
    area.Name = "PlotArea"
    area.Anchored = true
    area.CanCollide = false
    area.CanQuery = false
    area.CanTouch = false
    area.CastShadow = false
    area.Locked = true
    area.Transparency = 1
    area.Size = Vector3.new(H * 2, tall, H * 2)
    area.Position = Vector3.new(plot.x, y + tall / 2 - 2, plot.z)
    area:SetAttribute("BuildPlotKey", key)
    area.Parent = f

    local box = Instance.new("SelectionBox")
    box.Name = "PlotBounds"
    box.Adornee = area
    box.LineThickness = own and 1.2 or 0.7
    box.Color3 = own and Color3.fromRGB(255, 176, 0) or Color3.fromRGB(120, 160, 255)
    box.Transparency = own and 0.1 or 0.45
    box.SurfaceTransparency = 1
    box.Parent = f

    if plot.mode == "Baseplate" then
        local plate = Instance.new("Part")
        plate.Name = "BuildPlotBaseplate_" .. key
        plate.Anchored = true
        plate.Size = Vector3.new(CONFIG.Plots.BaseplateSize, 1, CONFIG.Plots.BaseplateSize)
        plate.Position = Vector3.new(plot.x, y - 0.45, plot.z)
        plate.Material = Enum.Material.SmoothPlastic
        plate.Color = Color3.fromRGB(105, 110, 120)
        plate.TopSurface = Enum.SurfaceType.Studs
        plate.BottomSurface = Enum.SurfaceType.Inlet
        plate:SetAttribute("BuildPlotKey", key)
        plate.Parent = f
    end

    f.Parent = plotFolder
    plotVisuals[key] = f
    plotAreas[key] = area
end

function dropPlot(key)
    local plot = plots[key]
    if not plot then return end
    plots[key] = nil
    plotWorldSettings[key] = nil
    plotOverrides[key] = nil
    local list = plotScripts[key]
    plotScripts[key] = nil
    if list then
        for idx in pairs(list) do pcall(Scripts.stop, "p_" .. key .. "_" .. idx, nil, true) end
    end
    if plotVisuals[key] then plotVisuals[key]:Destroy() end
    plotVisuals[key], plotAreas[key] = nil, nil
    local removeIds = {}
    for id, entry in pairs(all) do
        if entry.st.plot == key then removeIds[#removeIds + 1] = id end
    end
    for _, id in ipairs(removeIds) do remove(id) end
    if myPlot and myPlot.key == key then
        myPlot = nil
        toast("Your plot was lost - someone claimed overlapping ground first", true)
    end
    if activePlot == key then
        activePlot = nil
        pcall(applyPlotWorld, nil)
    end
end

acceptPlot = function(record)
    if type(record) ~= "table" or type(record.key) ~= "string" or #record.key > 32
        or type(record.owner) ~= "number" or record.key ~= plotKey(record.owner)
        or (record.mode ~= "Map" and record.mode ~= "Baseplate")
        or type(record.x) ~= "number" or type(record.z) ~= "number" or type(record.y) ~= "number"
        or record.x ~= record.x or record.z ~= record.z or record.y ~= record.y
        or math.abs(record.x) > 1e6 or math.abs(record.z) > 1e6 or math.abs(record.y) > 1e5 then return false end
    local t = tonumber(record.t) or 0
    local existing = plots[record.key]
    if existing and existing.owner == record.owner and existing.x == record.x and existing.z == record.z
        and existing.y == record.y and existing.mode == record.mode then
        return true
    end
    local losers = {}
    for key, other in pairs(plots) do
        if other.owner ~= record.owner and plotsOverlap(record, other) then
            local ot = tonumber(other.t) or 0
            local wins = t < ot or (t == ot and record.owner < other.owner)
            if not wins then return false end
            losers[#losers + 1] = key
        end
    end
    for _, key in ipairs(losers) do dropPlot(key) end
    local copyRecord = {
        key = record.key, owner = record.owner, name = tostring(record.name or record.owner):sub(1, 30),
        mode = record.mode, x = record.x, y = record.y, z = record.z, t = t > 0 and t or os.time(),
    }
    plots[record.key] = copyRecord
    updatePlotVisual(record.key, copyRecord)
    if copyRecord.owner == lp.UserId then myPlot = copyRecord end
    return true
end

removeOwnerPlots = function(owner)
    local keys = {}
    for key, plot in pairs(plots) do
        if plot.owner == owner then keys[#keys + 1] = key end
    end
    for _, key in ipairs(keys) do dropPlot(key) end
end

function sendPlotClaim(plot)
    publish({ u = lp.UserId, n = lp.Name, o = { { k = "pc", p = plot } } })
end

-- Y of the ground under the player's feet.
function groundBelow(root)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { lp.Character, plotFolder }
    local res = workspace:Raycast(root.Position, Vector3.new(0, -60, 0), params)
    if res then return res.Position.Y end
    local h = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
    return root.Position.Y - (h and (h.HipHeight + root.Size.Y / 2) or 3)
end

function claimPlot(mode)
    if myPlot then
        toast("You already own a plot", true)
        return
    end
    local character = lp.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then
        toast("Your character is not ready", true)
        return
    end
    local pos = root.Position
    local record = {
        key = plotKey(lp.UserId), owner = lp.UserId, name = lp.Name,
        mode = mode == "Baseplate" and "Baseplate" or "Map",
        x = math.floor(pos.X + 0.5), y = r3(groundBelow(root)), z = math.floor(pos.Z + 0.5), t = os.time(),
    }
    for _, other in pairs(plots) do
        if other.owner ~= lp.UserId and plotsOverlap(record, other) then
            toast("Another player's plot is already here - walk further away", true)
            return
        end
    end
    acceptPlot(record)
    sendPlotClaim(record)
    toast("Claim request sent. Checking availability...")
    task.delay(1.6, function()
        if not running then return end
        if plots[record.key] and plots[record.key].owner == lp.UserId then
            myPlot = plots[record.key]
            toast("Plot claimed! Its centre is where you stood.")
        else
            toast("That ground was claimed by someone else. Try again.", true)
        end
    end)
end

function releasePlot()
    if not myPlot then
        toast("You don't own a plot", true)
        return
    end
    local key = myPlot.key
    publish({ u = lp.UserId, n = lp.Name, o = { { k = "x" } } })
    clearMine()
    dropPlot(key)
    toast("Plot released")
end

function teleportToPlot(plot)
    local character = lp.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then toast("Your character is not ready", true) return end
    root.CFrame = CFrame.new(plot.x, (plot.y or 0) + 5, plot.z)
end

function plotForPosition(position)
    local key, plot = activePlotAt(position)
    return key, plot
end

-- Plot-wide scripts (day/night systems and so on). Slots 1..MaxPlotScripts per plot.
function setPlotScript(key, idx, name, src, broadcast)
    if type(key) ~= "string" or type(idx) ~= "number" or idx % 1 ~= 0
        or idx < 1 or idx > CONFIG.Scripts.MaxPlotScripts then return false end
    if type(src) ~= "string" or src == "" or #src > CONFIG.Scripts.MaxSource then src = nil end
    name = type(name) == "string" and ((name:gsub("[^%w _%-]", "")):sub(1, 24)) or ""
    if name == "" then name = "Plot script " .. idx end
    local runKey = "p_" .. key .. "_" .. idx
    local list = plotScripts[key]
    if not src then
        if list then
            list[idx] = nil
            if next(list) == nil then plotScripts[key] = nil end
        end
        Scripts.stop(runKey, nil, true)
    else
        if not list then
            list = {}
            plotScripts[key] = list
        end
        local old = list[idx]
        if old and old.src == src then
            old.n = name
        else
            list[idx] = { n = name, src = src }
        end
    end
    if broadcast then
        publish({ u = lp.UserId, n = lp.Name, o = { { k = "ps", plot = key, idx = idx, n = name, src = src } } })
    end
    Scripts.sync(runKey)
    return true
end

do
    local SC = CONFIG.Scripts
    local canRun = type(loadstring) == "function" and type(setfenv) == "function"
    local runningSB, runCount = {}, 0
    local errs, logs = Scripts.errs, Scripts.logs
    Scripts.canRun = canRun
    Scripts.running = runningSB

    local function log(id, msg)
        local l = logs[id]
        if not l then
            l = {}
            logs[id] = l
        end
        l[#l + 1] = tostring(msg):sub(1, 160)
        if #l > 8 then table.remove(l, 1) end
    end
    Scripts.log = log

    local BAN = { "getfenv", "setfenv", "loadstring", "getgenv", "getrenv", "getreg", "getgc", "hookfunction",
        "hookmetamethod", "newcclosure", "checkcaller", "syn", "request", "http_request", "require", "_G", "_ENV",
        "shared", "debug", "game", "workspace", "getmetatable", "rawset", "rawget", "dump", "rep", "coroutine",
        "Instance", "GetService", "HttpService", "Players", "TweenService", "RunService" }

    local function strip(src)
        local s = src:gsub("%-%-%[(=*)%[.-%]%1%]", " ")
        s = s:gsub("%-%-[^\n]*", " ")
        s = s:gsub("%[(=*)%[.-%]%1%]", '""')
        s = s:gsub('"[^"\n]*"', '""')
        s = s:gsub("'[^'\n]*'", "''")
        return s
    end

    function Scripts.check(src)
        if type(src) ~= "string" then return false, "no script" end
        if #src > SC.MaxSource then return false, "script is longer than " .. SC.MaxSource .. " characters" end
        if src:find("[\0-\8\14-\31]") then return false, "script has invalid characters" end
        local code = strip(src)
        for _, w in ipairs(BAN) do
            if code:find("%f[%w_]" .. w .. "%f[^%w_]") then
                return false, "'" .. w .. "' is not allowed in build scripts"
            end
        end
        local loops = 0
        for _ in code:gmatch("%f[%w_]while%f[^%w_]") do loops += 1 end
        for _ in code:gmatch("%f[%w_]repeat%f[^%w_]") do loops += 1 end
        local waits = 0
        for _ in code:gmatch("wait%s*%(") do waits += 1 end
        if loops > waits then return false, "every while/repeat loop needs a wait() inside it" end
        local product = 1
        for head in code:gmatch("%f[%w_]for%s+[%w_]+%s*=([^\n]-)%f[%w_]do%f[^%w_]") do
            if head:find("huge") or head:find("1%s*/%s*0") then return false, "loop bound is too large" end
            local biggest = 1
            for num in head:gmatch("%d+%.?%d*[eE]?[%+%-]?%d*") do
                local v = tonumber(num)
                if v and v > biggest then biggest = v end
            end
            product *= biggest
        end
        if product > 1e6 then return false, "loops run too many iterations" end
        if code:find("([%a_][%w_%.]*)%s*=%s*%1%s*%.%.%s*%1") then
            return false, "a string can't be concatenated with itself"
        end
        return true
    end

    local function okNum(n) return type(n) == "number" and n == n and math.abs(n) < 1e5 end
    local function okV3(v) return typeof(v) == "Vector3" and okNum(v.X) and okNum(v.Y) and okNum(v.Z) end
    local function num01(v)
        assert(type(v) == "number" and v == v, "expected a number")
        return math.clamp(v, 0, 1)
    end

    local PROPS = {
        Position = { g = function(i) return i.Position end,
            s = function(i, v) assert(okV3(v), "Position must be a Vector3") i.Position = v end },
        Orientation = { g = function(i) return i.Orientation end,
            s = function(i, v) assert(okV3(v), "Orientation must be a Vector3") i.Orientation = v end },
        Size = { g = function(i) return i.Size end,
            s = function(i, v)
                assert(okV3(v), "Size must be a Vector3")
                i.Size = Vector3.new(math.clamp(v.X, 0.05, 2048), math.clamp(v.Y, 0.05, 2048), math.clamp(v.Z, 0.05, 2048))
            end },
        CFrame = { g = function(i) return i.CFrame end,
            s = function(i, v) assert(typeof(v) == "CFrame" and okV3(v.Position), "CFrame must be a valid CFrame") i.CFrame = v end },
        Color = { g = function(i) return i.Color end,
            s = function(i, v) assert(typeof(v) == "Color3", "Color must be a Color3") i.Color = v end },
        Material = { g = function(i) return i.Material end,
            s = function(i, v)
                assert(typeof(v) == "EnumItem" and v.EnumType == Enum.Material, "Material must be an Enum.Material")
                i.Material = v
            end },
        Transparency = { g = function(i) return i.Transparency end, s = function(i, v) i.Transparency = num01(v) end },
        Reflectance = { g = function(i) return i.Reflectance end, s = function(i, v) i.Reflectance = num01(v) end },
        CanCollide = { g = function(i) return i.CanCollide end,
            s = function(i, v) assert(type(v) == "boolean", "CanCollide must be a boolean") i.CanCollide = v end },
        Name = { g = function(i) return i.Name end },
    }

    local TWCHK = {
        Position = okV3, Orientation = okV3, Size = okV3,
        CFrame = function(v) return typeof(v) == "CFrame" and okV3(v.Position) end,
        Color = function(v) return typeof(v) == "Color3" end,
        Transparency = function(v) return type(v) == "number" and v == v end,
        Reflectance = function(v) return type(v) == "number" and v == v end,
    }

    local function hum()
        local c = lp.Character
        if not c then return nil, nil end
        return c:FindFirstChildOfClass("Humanoid"), c:FindFirstChild("HumanoidRootPart")
    end

    local function resetVisual(e)
        local p, st = e.inst, e.st
        pcall(function()
            p.CFrame = decCF(st.cf)
            p.Size = szOf(st)
            p.Color = hex2c(st.col)
            p.Material = MATENUM[st.m] or Enum.Material.Plastic
            p.Transparency = math.clamp(st.t, 0, 1)
            p.Reflectance = 0
            p.CanCollide = true
        end)
    end

    local function makeSignal(sb, hook, eventName)
        local s = {}
        function s.Connect(a, b)
            local fn = type(a) == "function" and a or b
            if type(fn) ~= "function" then error("Connect needs a function", 2) end
            if not sb.alive then return nil end
            if sb.nconn >= SC.MaxConnections then error("too many connections (max " .. SC.MaxConnections .. ")", 2) end
            sb.nconn += 1
            local callback = function(...)
                if sb.alive then sb.guard(fn, ...) end
            end
            local rc = hook(callback)
            sb.conns[#sb.conns + 1] = rc
            if eventName then
                sb.eventHandlers[eventName] = sb.eventHandlers[eventName] or {}
                table.insert(sb.eventHandlers[eventName], callback)
            end
            return { Disconnect = function()
                pcall(function() rc:Disconnect() end)
                if eventName and sb.eventHandlers[eventName] then
                    local list = sb.eventHandlers[eventName]
                    for i = #list, 1, -1 do
                        if list[i] == callback then table.remove(list, i) end
                    end
                end
            end }
        end
        return s
    end

    local function touchHook(sb, inst)
        return function(wrapped)
            local last = 0
            return inst.Touched:Connect(function(hit)
                local ch = lp.Character
                if ch and hit:IsDescendantOf(ch) then
                    local now = os.clock()
                    if now - last >= 0.1 then
                        last = now
                        wrapped(sb.playerProxy)
                    end
                end
            end)
        end
    end

    local function clickHook(sb, inst)
        return function(wrapped)
            local cd = inst:FindFirstChild("NBClick")
            if not cd then
                cd = Instance.new("ClickDetector")
                cd.Name = "NBClick"
                cd.MaxActivationDistance = 40
                cd:SetAttribute("NBS", true)
                cd.Parent = inst
            end
            return cd.MouseClick:Connect(function() wrapped(sb.playerProxy) end)
        end
    end

    local function partProxy(sb, inst, created)
        if sb.proxies[inst] then return sb.proxies[inst] end
        local sigs = {}

        local function tweenFn(_, props, time, style, dir)
            if type(props) ~= "table" then error("Tween needs a table of properties", 2) end
            if not isPlayerInPlot(sb.plot) then error("script is outside its plot", 2) end
            if sb.ntw >= 40 then error("too many active tweens", 2) end
            local goal = {}
            for k, v in pairs(props) do
                local chk = TWCHK[k]
                if not chk then error("cannot tween '" .. tostring(k) .. "'", 2) end
                if not chk(v) then error("bad value for " .. tostring(k), 2) end
                local destination = k == "Position" and v or k == "CFrame" and v.Position or nil
                local targetSize = k == "Size" and typeof(v) == "Vector3" and Vector3.new(
                    math.clamp(v.X, 0.05, 2048), math.clamp(v.Y, 0.05, 2048), math.clamp(v.Z, 0.05, 2048)) or inst.Size
                if destination and not insidePlotPart(destination, targetSize, plots[sb.plot]) then error("tween would leave this plot", 2) end
                if k == "Size" and not insidePlotPart(inst.Position, targetSize, plots[sb.plot]) then error("size would leave this plot", 2) end
                if k == "Size" then
                    v = Vector3.new(math.clamp(v.X, 0.05, 2048), math.clamp(v.Y, 0.05, 2048), math.clamp(v.Z, 0.05, 2048))
                elseif k == "Transparency" or k == "Reflectance" then
                    v = math.clamp(v, 0, 1)
                end
                goal[k] = v
            end
            time = math.clamp(tonumber(time) or 1, 0.05, 30)
            if not (typeof(style) == "EnumItem" and style.EnumType == Enum.EasingStyle) then style = Enum.EasingStyle.Quad end
            if not (typeof(dir) == "EnumItem" and dir.EnumType == Enum.EasingDirection) then dir = Enum.EasingDirection.Out end
            local tw = TweenService:Create(inst, TweenInfo.new(time, style, dir), goal)
            sb.tweens[tw] = true
            sb.ntw += 1
            tw.Completed:Connect(function()
                sb.tweens[tw] = nil
                sb.ntw -= 1
            end)
            tw:Play()
            return { Cancel = function() tw:Cancel() end }
        end

        local function destroyFn()
            if created and inst.Parent then
                inst:Destroy()
                sb.ncreated -= 1
            end
        end

        local mt = { __metatable = "locked" }
        mt.__index = function(_, k)
            local p = PROPS[k]
            if p then return p.g(inst) end
            if k == "Touched" or k == "Clicked" then
                if not sigs[k] then
                    sigs[k] = makeSignal(sb, k == "Touched" and touchHook(sb, inst) or clickHook(sb, inst), k)
                end
                return sigs[k]
            end
            if k == "Tween" then return tweenFn end
            if k == "Id" then return inst:GetAttribute("NB") end
            if k == "Fire" then
                return function(_, eventName, ...)
                    local targetId = inst:GetAttribute("NB")
                    local target = targetId and runningSB[targetId]
                    if not target or not target.alive or target.plot ~= sb.plot or not isPlayerInPlot(sb.plot) then return false end
                    local list = target.eventHandlers[tostring(eventName or "Clicked")]
                    if not list then return false end
                    for _, callback in ipairs(table.clone(list)) do callback(target.playerProxy, ...) end
                    return true
                end
            end
            if k == "Destroy" and created then return destroyFn end
            return nil
        end
        mt.__newindex = function(_, k, v)
            local p = PROPS[k]
            if p and p.s then
                if not isPlayerInPlot(sb.plot) then error("script is outside its plot", 2) end
                local destination = k == "Position" and v or k == "CFrame" and typeof(v) == "CFrame" and v.Position or nil
                if destination and not insidePlotPart(destination, inst.Size, plots[sb.plot]) then error("part cannot leave its plot", 2) end
                if k == "Size" and typeof(v) == "Vector3" then
                    local checkedSize = Vector3.new(math.clamp(v.X, 0.05, 2048), math.clamp(v.Y, 0.05, 2048), math.clamp(v.Z, 0.05, 2048))
                    if not insidePlotPart(inst.Position, checkedSize, plots[sb.plot]) then error("size would leave this plot", 2) end
                end
                local ok, err = pcall(p.s, inst, v)
                if not ok then error(tostring(err), 2) end
            else
                error("cannot set '" .. tostring(k) .. "'", 2)
            end
        end
        mt.__tostring = function() return "BuildPart" end
        local px = setmetatable({}, mt)
        sb.proxies[inst] = px
        return px
    end

    local function modelProxy(sb)
        local mdl = sb.mdl
        local sigs = {}
        local function members()
            local out = {}
            for _, e in ipairs(modelMembers(mdl)) do
                if e.st.plot == sb.plot and e.inst.Parent then out[#out + 1] = e end
            end
            return out
        end
        local function center()
            local lo, hi
            for _, e in ipairs(members()) do
                local p = e.inst.Position
                if lo then
                    lo = Vector3.new(math.min(lo.X, p.X), math.min(lo.Y, p.Y), math.min(lo.Z, p.Z))
                    hi = Vector3.new(math.max(hi.X, p.X), math.max(hi.Y, p.Y), math.max(hi.Z, p.Z))
                else
                    lo, hi = p, p
                end
            end
            if not lo then return Vector3.zero end
            return (lo + hi) / 2
        end
        local function signalFor(k)
            local hookMaker = k == "Touched" and touchHook or clickHook
            return makeSignal(sb, function(wrapped)
                local last, cs = 0, {}
                local function shared(...)
                    local now = os.clock()
                    if now - last >= 0.1 then
                        last = now
                        wrapped(...)
                    end
                end
                for _, e in ipairs(members()) do
                    cs[#cs + 1] = hookMaker(sb, e.inst)(shared)
                end
                return { Disconnect = function()
                    for _, c in ipairs(cs) do pcall(function() c:Disconnect() end) end
                end }
            end, k)
        end
        local px
        local mt = { __metatable = "locked" }
        mt.__index = function(_, k)
            if k == "Id" then return mdl end
            if k == "Name" then
                local m = members()[1]
                return m and m.st.mname or "Model"
            end
            if k == "Position" then return center() end
            if k == "Count" then return #members() end
            if k == "GetParts" then
                return function()
                    local out = {}
                    for _, e in ipairs(members()) do out[#out + 1] = partProxy(sb, e.inst, false) end
                    return out
                end
            end
            if k == "Move" then
                return function(a, b)
                    local off = typeof(a) == "Vector3" and a or b
                    if not okV3(off) then error("Move needs a Vector3", 2) end
                    if not isPlayerInPlot(sb.plot) then error("script is outside its plot", 2) end
                    local list = members()
                    for _, e in ipairs(list) do
                        if not insidePlotPart(e.inst.Position + off, e.inst.Size, plots[sb.plot]) then
                            error("model would leave this plot", 2)
                        end
                    end
                    for _, e in ipairs(list) do e.inst.Position = e.inst.Position + off end
                end
            end
            if k == "Tween" then
                return function(_, props, time, style, dir)
                    if type(props) ~= "table" then error("Tween needs a table of properties", 2) end
                    local delta = Vector3.zero
                    if props.Position ~= nil then
                        if not okV3(props.Position) then error("Position must be a Vector3", 2) end
                        delta = props.Position - center()
                    end
                    local cancels = {}
                    for _, e in ipairs(members()) do
                        local goal = {}
                        for pk, pv in pairs(props) do
                            if pk == "Position" then goal.Position = e.inst.Position + delta else goal[pk] = pv end
                        end
                        local mp = partProxy(sb, e.inst, false)
                        cancels[#cancels + 1] = mp.Tween(mp, goal, time, style, dir)
                    end
                    return { Cancel = function()
                        for _, c in ipairs(cancels) do pcall(c.Cancel) end
                    end }
                end
            end
            if k == "Touched" or k == "Clicked" then
                if not sigs[k] then sigs[k] = signalFor(k) end
                return sigs[k]
            end
            return nil
        end
        mt.__newindex = function() error("model is read-only - use :Move() or :Tween()", 2) end
        mt.__tostring = function() return "BuildModel" end
        px = setmetatable({}, mt)
        return px
    end

    local function makePlayer(sb)
        local function near()
            local _, root = hum()
            if not (isPlayerInPlot(sb.plot) and root ~= nil) then return false end
            if sb.kind == "plot" then return true end
            if sb.kind == "model" then
                for _, m in ipairs(modelMembers(sb.mdl)) do
                    if (root.Position - m.inst.Position).Magnitude <= SC.ProximityLimit then return true end
                end
                return false
            end
            return (root.Position - sb.part.Position).Magnitude <= SC.ProximityLimit
        end
        local function save(h)
            if not sb.saved then sb.saved = { ws = h.WalkSpeed, jp = h.JumpPower, uj = h.UseJumpPower } end
        end
        local function argn(a, b) return type(a) == "number" and a or b end
        local pp = { Name = lp.Name, DisplayName = lp.DisplayName, UserId = lp.UserId }
        function pp.GetPosition()
            local _, root = hum()
            return root and root.Position or nil
        end
        function pp.SetWalkSpeed(a, b)
            local n = tonumber(argn(a, b))
            local h = hum()
            if not n or not h or not near() then return end
            save(h)
            h.WalkSpeed = math.clamp(n, 8, 100)
        end
        function pp.SetJumpPower(a, b)
            local n = tonumber(argn(a, b))
            local h = hum()
            if not n or not h or not near() then return end
            save(h)
            h.UseJumpPower = true
            h.JumpPower = math.clamp(n, 20, 150)
        end
        function pp.ResetStats() sb.restore() end
        function pp.Teleport(a, b)
            local dest = typeof(a) == "Vector3" and a or b
            local _, root = hum()
            if not root or not okV3(dest) or not near() or not insidePlot(dest, plots[sb.plot]) then return end
            local origin = sb.kind == "plot" and root.Position or sb.part.Position
            if (dest - origin).Magnitude > (sb.kind == "plot" and 3000 or 500) then return end
            if os.clock() - sb.lastTp < 2 then return end
            sb.lastTp = os.clock()
            root.CFrame = CFrame.new(dest + Vector3.new(0, 3, 0))
        end
        return pp
    end

    local function mkTask(sb)
        local t = {}
        local function alive()
            if not sb.alive or not isPlayerInPlot(sb.plot) then
                if sb.alive then Scripts.stop(sb.id, nil, true) end
                pcall(task.cancel, coroutine.running())
                coroutine.yield()
            end
        end
        t.wait = function(n)
            n = math.clamp(tonumber(n) or 0, 0.03, 600)
            task.wait(n)
            alive()
            return n
        end
        local function spawnT(delayS, fn, ...)
            if type(fn) ~= "function" then error("expected a function", 3) end
            if sb.nthr >= SC.MaxThreads then error("too many threads (max " .. SC.MaxThreads .. ")", 3) end
            sb.nthr += 1
            local args = table.pack(...)
            task.spawn(function()
                local th = coroutine.running()
                sb.thr[th] = true
                if delayS then t.wait(delayS) end
                sb.guard(fn, table.unpack(args, 1, args.n))
                sb.thr[th] = nil
                sb.nthr -= 1
            end)
        end
        t.spawn = function(fn, ...) spawnT(nil, fn, ...) end
        t.defer = t.spawn
        t.delay = function(n, fn, ...) spawnT(tonumber(n) or 0, fn, ...) end
        return t
    end

    local CREATE = { Block = true, Ball = true, Cylinder = true, Wedge = true }

    local function buildEnv(sb)
        local env = {}
        env.assert, env.error, env.ipairs, env.next, env.pairs = assert, error, ipairs, next, pairs
        env.pcall, env.select, env.tonumber, env.tostring, env.type = pcall, select, tonumber, tostring, type
        env.typeof, env.unpack, env.xpcall, env.setmetatable, env.rawequal, env.rawlen =
            typeof, table.unpack, xpcall, setmetatable, rawequal, rawlen
        env.math = copy(math)
        local str = copy(string)
        str.rep, str.dump = nil, nil
        env.string = str
        local tbl = copy(table)
        tbl.create = function(n, v) return table.create(math.clamp(tonumber(n) or 0, 0, 10000), v) end
        env.table = tbl
        env.os = { time = os.time, clock = os.clock, date = os.date }
        env.utf8, env.bit32 = utf8, bit32
        env.Vector3, env.Vector2, env.CFrame, env.Color3 = Vector3, Vector2, CFrame, Color3
        env.BrickColor, env.Random, env.Enum = BrickColor, Random, Enum

        local function pr(...)
            local t = {}
            for i = 1, select("#", ...) do t[i] = tostring((select(i, ...))) end
            log(sb.id, table.concat(t, " "))
        end
        env.print, env.warn = pr, pr

        local tk = mkTask(sb)
        env.task = tk
        env.wait, env.spawn, env.delay = tk.wait, tk.spawn, tk.delay

        env.Heartbeat = makeSignal(sb, function(w) return RunService.Heartbeat:Connect(w) end)
        env.Input = {
            KeyPressed = makeSignal(sb, function(w)
                return UIS.InputBegan:Connect(function(i, gp)
                    if gp or UIS:GetFocusedTextBox() then return end
                    if i.UserInputType == Enum.UserInputType.Keyboard then w(i.KeyCode.Name) end
                end)
            end),
            IsKeyDown = function(name)
                if UIS:GetFocusedTextBox() then return false end
                local ok, kc = pcall(function() return Enum.KeyCode[name] end)
                return ok and kc ~= nil and UIS:IsKeyDown(kc) or false
            end,
        }
        env.LocalPlayer = sb.playerProxy
        env.notify = function(text)
            if os.clock() - sb.lastNote < 3 then return end
            sb.lastNote = os.clock()
            toast("[Script] " .. tostring(text):sub(1, 60))
        end
        env.Create = function(class, props)
            if not isPlayerInPlot(sb.plot) then error("script is outside its plot", 2) end
            if not CREATE[class] then error("Create: class must be Block, Ball, Cylinder or Wedge", 2) end
            if sb.ncreated >= SC.MaxCreated then error("too many created parts (max " .. SC.MaxCreated .. ")", 2) end
            sb.ncreated += 1
            local p = makeInst(class)
            p.Anchored = true
            p.CanQuery = false
            p.Size = Vector3.new(2, 2, 2)
            if sb.kind == "plot" then
                local pl = plots[sb.plot]
                p.Position = Vector3.new(pl.x, (pl.y or 0) + 5, pl.z)
            else
                p.Position = sb.part.Position + Vector3.new(0, sb.part.Size.Y / 2 + 2, 0)
            end
            if not insidePlotPart(p.Position, p.Size, plots[sb.plot]) then sb.ncreated -= 1 p:Destroy() error("created part would leave this plot", 2) end
            p.Parent = sb.folder
            local px = partProxy(sb, p, true)
            if type(props) == "table" then
                for k, v in pairs(props) do px[k] = v end
            end
            return px
        end
        env.getPart = function(id)
            local e = type(id) == "string" and all[id]
            if not e and type(id) == "string" then
                for _, candidate in pairs(all) do
                    if candidate.inst.Name == id then e = candidate break end
                end
            end
            if e and e.st.plot == sb.plot and insidePlot(e.inst.Position, plots[sb.plot]) then return partProxy(sb, e.inst, false) end
            return nil
        end
        env.firePart = function(id, eventName, ...)
            local target = env.getPart(id)
            if not target then return false end
            return target:Fire(eventName or "Clicked", ...)
        end
        env.Music = {
            Play = function(index) if isPlayerInPlot(sb.plot) then return Music.Play(index) end return false end,
            Next = function() if isPlayerInPlot(sb.plot) then return Music.Next() end return false end,
            Stop = function() if isPlayerInPlot(sb.plot) then return Music.Stop() end return false end,
            SetVolume = function(value) if isPlayerInPlot(sb.plot) then return Music.SetVolume(value) end return false end,
            GetCurrent = function() if isPlayerInPlot(sb.plot) then return Music.GetCurrent() end return nil end,
        }

        if sb.kind == "plot" then
            local LIGHT = {
                clockTime = function(v) Lighting.ClockTime = v end,
                brightness = function(v) Lighting.Brightness = v end,
                fogEnd = function(v) Lighting.FogEnd = v end,
                fogStart = function(v) Lighting.FogStart = v end,
                fogColor = function(v) Lighting.FogColor = v end,
                ambient = function(v) Lighting.Ambient = v end,
                outdoorAmbient = function(v) Lighting.OutdoorAmbient = v end,
                exposure = function(v) Lighting.ExposureCompensation = v end,
                gravity = function(v) workspace.Gravity = v end,
            }
            local function ovset(field, v)
                local t = plotOverrides[sb.plot]
                if not t then
                    t = {}
                    plotOverrides[sb.plot] = t
                end
                local o = t[sb.id]
                if not o then
                    o = {}
                    t[sb.id] = o
                end
                o[field] = v
                if sb.alive and activePlot == sb.plot then LIGHT[field](v) end
            end
            local function narg(a, b)
                local v = type(a) == "table" and b or a
                v = tonumber(v)
                if not v or v ~= v or v == math.huge or v == -math.huge then return nil end
                return v
            end
            local function carg(a, b)
                local v = type(a) == "table" and b or a
                return typeof(v) == "Color3" and v or nil
            end
            local function numSetter(field, lo, hi, wrap)
                return function(a, b)
                    local n = narg(a, b)
                    if not n then return end
                    if wrap then n = n % wrap end
                    ovset(field, math.clamp(n, lo, hi))
                end
            end
            local function colSetter(field)
                return function(a, b)
                    local c = carg(a, b)
                    if c then ovset(field, c) end
                end
            end
            env.World = {
                SetClockTime = numSetter("clockTime", 0, 24, 24),
                SetBrightness = numSetter("brightness", 0, 10),
                SetFogEnd = numSetter("fogEnd", 0, 100000),
                SetFogStart = numSetter("fogStart", 0, 100000),
                SetGravity = numSetter("gravity", 0, 1000),
                SetExposure = numSetter("exposure", -3, 3),
                SetFogColor = colSetter("fogColor"),
                SetAmbient = colSetter("ambient"),
                SetOutdoorAmbient = colSetter("outdoorAmbient"),
                GetClockTime = function() return Lighting.ClockTime end,
                GetBrightness = function() return Lighting.Brightness end,
                GetCenter = function()
                    local pl = plots[sb.plot]
                    return pl and Vector3.new(pl.x, pl.y or 0, pl.z) or Vector3.zero
                end,
                Reset = function()
                    local t = plotOverrides[sb.plot]
                    if t then t[sb.id] = nil end
                    if activePlot == sb.plot then pcall(applyPlotLighting, sb.plot) end
                end,
            }
        end

        env.script = setmetatable({}, {
            __index = function(_, k)
                if k == "Parent" then
                    if sb.kind == "plot" then return nil end
                    if sb.kind == "model" then return sb.modelProxy end
                    return partProxy(sb, sb.part, false)
                end
                if k == "Id" then return sb.id end
                if k == "Name" then return sb.kind == "plot" and "PlotScript" or sb.kind == "model" and "ModelScript" or "BuildScript" end
                return nil
            end,
            __newindex = function() error("script is read-only", 2) end,
            __metatable = "locked",
        })
        return env
    end

    -- Everything that can run is addressed by a key: part id, "m_<model id>" or "p_<plot key>_<slot>".
    local function info(key)
        if type(key) ~= "string" then return nil end
        local head = key:sub(1, 2)
        if head == "m_" then
            local mdl = key:sub(3)
            local root = modelRoot(mdl)
            if not root then return nil end
            Scripts.mstate = Scripts.mstate or {}
            local state = Scripts.mstate[mdl]
            if not state then
                state = {}
                Scripts.mstate[mdl] = state
            end
            return { key = key, kind = "model", mdl = mdl, src = root.st.msrc, part = root.inst,
                plot = root.st.plot, owner = root.owner, state = state }
        elseif head == "p_" then
            local pk, idx = key:match("^p_(.+)_(%d+)$")
            idx = tonumber(idx)
            local rec = pk and plotScripts[pk] and plotScripts[pk][idx]
            local plot = pk and plots[pk]
            local area = pk and plotAreas[pk]
            if not rec or not plot or not area then return nil end
            return { key = key, kind = "plot", src = rec.src, part = area, plot = pk, owner = plot.owner, state = rec }
        end
        local e = all[key]
        if not e then return nil end
        return { key = key, kind = "part", src = e.st.src, part = e.inst, plot = e.st.plot, owner = e.owner,
            state = e, entry = e }
    end
    Scripts.info = info

    local function shouldRun(i)
        if not canRun or not S.scripts or not i.src or i.state.paused then return false end
        if not i.plot or not isPlayerInPlot(i.plot) then return false end
        return i.owner == lp.UserId or S.runOthers or i.state.approved == true
    end

    local function start(id)
        local i = info(id)
        if not i then return end
        local src = i.src
        errs[id] = nil
        local ok, why = Scripts.check(src)
        if not ok then
            errs[id] = why
            log(id, why)
            return
        end
        if runCount >= SC.MaxRunning then
            errs[id] = "too many scripts running"
            return
        end
        local sb = {
            id = id, src = src, part = i.part, plot = i.plot, kind = i.kind, mdl = i.mdl, alive = true,
            conns = {}, nconn = 0, thr = {}, nthr = 0, tweens = {}, ntw = 0, proxies = {},
            eventHandlers = {}, nerr = 0, ncreated = 0, lastNote = 0, lastTp = 0,
        }
        sb.folder = Instance.new("Folder")
        sb.folder.Name = "NBS_" .. id
        sb.folder.Parent = folder
        sb.restore = function()
            if sb.saved then
                local h = hum()
                if h then
                    h.WalkSpeed = sb.saved.ws
                    h.UseJumpPower = sb.saved.uj
                    h.JumpPower = sb.saved.jp
                end
                sb.saved = nil
            end
        end
        sb.guard = function(fn, ...)
            if not sb.alive or not isPlayerInPlot(sb.plot) then return end
            local ok2, err = pcall(fn, ...)
            if not ok2 then
                sb.nerr += 1
                log(id, "error: " .. tostring(err))
                if sb.nerr >= SC.MaxErrors then Scripts.stop(id, "stopped: too many errors") end
            end
        end
        sb.playerProxy = makePlayer(sb)
        if sb.kind == "model" then sb.modelProxy = modelProxy(sb) end
        local fn, err = loadstring(src, "=BuildScript")
        if not fn then
            errs[id] = tostring(err):sub(1, 120)
            log(id, err)
            pcall(function() sb.folder:Destroy() end)
            return
        end
        local okEnv = pcall(setfenv, fn, buildEnv(sb))
        if not okEnv then
            errs[id] = "could not sandbox the script"
            pcall(function() sb.folder:Destroy() end)
            return
        end
        runningSB[id] = sb
        runCount += 1
        task.spawn(function()
            sb.thr[coroutine.running()] = true
            sb.guard(fn)
        end)
    end

    function Scripts.stop(id, reason, noReset)
        local sb = runningSB[id]
        if not sb then return end
        runningSB[id] = nil
        runCount -= 1
        sb.alive = false
        for _, c in ipairs(sb.conns) do pcall(function() c:Disconnect() end) end
        for tw in pairs(sb.tweens) do pcall(function() tw:Cancel() end) end
        local curTh = coroutine.running()
        for th in pairs(sb.thr) do
            if th ~= curTh then pcall(task.cancel, th) end
        end
        sb.restore()
        pcall(function() sb.folder:Destroy() end)
        if sb.kind == "model" then
            for _, m in ipairs(modelMembers(sb.mdl)) do
                for _, c in ipairs(m.inst:GetChildren()) do
                    if c:GetAttribute("NBS") then c:Destroy() end
                end
                if not noReset then resetVisual(m) end
            end
        elseif sb.kind == "plot" then
            local t = plotOverrides[sb.plot]
            if t then
                t[id] = nil
                if next(t) == nil then plotOverrides[sb.plot] = nil end
            end
            if activePlot == sb.plot then pcall(applyPlotLighting, sb.plot) end
        else
            local e = all[id]
            if e and e.inst then
                for _, c in ipairs(e.inst:GetChildren()) do
                    if c:GetAttribute("NBS") then c:Destroy() end
                end
                if not noReset then resetVisual(e) end
            end
        end
        if reason then
            errs[id] = reason
            log(id, reason)
        end
    end

    function Scripts.sync(id)
        local i = info(id)
        local sb = runningSB[id]
        if not i then
            if sb then Scripts.stop(id, nil, true) end
            return
        end
        if not i.src and not sb then return end
        local want = shouldRun(i)
        if want and i.kind == "model" and not sb
            and os.clock() - (modelTouched[i.mdl] or 0) < 0.6 then
            return -- let every part of a freshly placed model arrive before it starts
        end
        if sb and (not want or sb.src ~= i.src or sb.part ~= i.part) then
            Scripts.stop(id)
            sb = nil
        end
        if want and not sb then start(id) end
    end

    function Scripts.syncAll()
        local keys, seen = {}, {}
        local function add(k)
            if not seen[k] then
                seen[k] = true
                keys[#keys + 1] = k
            end
        end
        for id, e in pairs(all) do
            if e.st.src then add(id) end
            if e.st.msrc and e.st.mdl then add("m_" .. e.st.mdl) end
        end
        for pk, list in pairs(plotScripts) do
            for idx in pairs(list) do add("p_" .. pk .. "_" .. idx) end
        end
        for k in pairs(runningSB) do add(k) end
        for _, k in ipairs(keys) do Scripts.sync(k) end
    end

    function Scripts.restart(id)
        Scripts.stop(id)
        Scripts.sync(id)
    end

    function Scripts.toggle(id)
        local i = id and info(id)
        if not i then
            toast("Select a part first", true)
            return
        end
        if not i.src then
            toast("This has no script", true)
            return
        end
        if runningSB[id] then
            i.state.paused = true
            i.state.approved = false
            Scripts.stop(id)
        else
            i.state.paused = false
            if i.owner ~= lp.UserId then i.state.approved = true end
            errs[id] = nil
            Scripts.sync(id)
        end
        refreshProps()
    end

    function Scripts.status(id)
        local i = id and info(id)
        if not i or not i.src then return "No script" end
        if runningSB[id] then return "Running" end
        if errs[id] then return "Error: " .. errs[id] end
        if not canRun then return "Your executor has no loadstring/setfenv - scripts are disabled" end
        if not S.scripts then return "Scripts are turned off in Settings" end
        if i.state.paused then return "Stopped" end
        if i.owner ~= lp.UserId and not S.runOthers and not i.state.approved then
            return "Not running - this is someone else's script, press Run to approve it"
        end
        return "Idle"
    end

    function Scripts.stopAll()
        local ids = {}
        for id in pairs(runningSB) do ids[#ids + 1] = id end
        for _, id in ipairs(ids) do Scripts.stop(id, nil, true) end
    end

    local acc = 0
    connect(RunService.Heartbeat, function(dt)
        acc += dt
        if acc < 0.5 then return end
        acc = 0
        for id, sb in pairs(runningSB) do
            if not sb.part.Parent then
                Scripts.stop(id, nil, true)
            elseif sb.saved then
                local _, root = hum()
                if not root or (root.Position - sb.part.Position).Magnitude > SC.ProximityLimit + 25 then
                    sb.restore()
                end
            end
        end
    end)
end

