    corner(holder, 8)
    stroke(holder, C.line, 1)
    local srcBox = new("TextBox", { Size = UDim2.new(1, -12, 1, -10), Position = UDim2.fromOffset(6, 5),
        BackgroundTransparency = 1, Text = "", MultiLine = true, TextWrapped = false, ClearTextOnFocus = false,
        Font = Enum.Font.Code, TextSize = 13, TextColor3 = Color3.fromRGB(225, 230, 240),
        TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top }, holder)

    local info = label(cur, "", { Size = UDim2.new(1, 0, 0, 30), TextSize = 11, TextWrapped = true,
        TextYAlignment = Enum.TextYAlignment.Top, LayoutOrder = nextO() })

    local exIdx = 0
    local br = srow(28)
    button(br, "Save & Run", function() CodeUI.save() end, { Size = cellW(4), TextSize = 11 })
    button(br, "Run / Stop", function()
        local key = CodeUI.key()
        if key then Scripts.toggle(key) end
    end, { Size = cellW(4), TextSize = 11 })
    button(br, "Example", function()
        if not srcBox.TextEditable then return end
        local list = CodeUI.mode == "plot" and PLOT_TEMPLATES or MODEL_TEMPLATES
        exIdx = exIdx % #list + 1
        srcBox.Text = list[exIdx][2]
        toast("Example: " .. list[exIdx][1])
    end, { Size = cellW(4), TextSize = 11 })
    button(br, "Clear", function()
        if srcBox.TextEditable then srcBox.Text = "" end
    end, { Size = cellW(4), TextSize = 11 })
    label(cur, "Clear the box and press Save & Run to delete the script.",
        { Size = UDim2.new(1, 0, 0, 14), TextSize = 10, TextColor3 = C.muted, LayoutOrder = nextO() })

    secTitle("OUTPUT")
    local out = label(cur, "", { Size = UDim2.new(1, 0, 0, 60), TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top,
        Font = Enum.Font.Code, TextSize = 11, LayoutOrder = nextO() })
    sdiv()
    secTitle("API")
    label(cur, API_TEXT, { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextWrapped = true,
        TextSize = 11, Font = Enum.Font.Code, TextYAlignment = Enum.TextYAlignment.Top, LayoutOrder = nextO() })

    function CodeUI.key()
        if CodeUI.mode == "model" and CodeUI.mdl then return "m_" .. CodeUI.mdl end
        if CodeUI.mode == "plot" and myPlot then return "p_" .. myPlot.key .. "_" .. CodeUI.idx end
        return nil
    end

    local function refreshInfo()
        local key = CodeUI.key()
        if not key then
            info.Text = ""
            out.Text = ""
            return
        end
        info.Text = Scripts.status(key) .. "   |   " .. #srcBox.Text .. "/" .. CONFIG.Scripts.MaxSource
        local l = Scripts.logs[key]
        out.Text = l and table.concat(l, "\n") or ""
    end
    connect(srcBox:GetPropertyChangedSignal("Text"), refreshInfo)

    function CodeUI.load()
        local mode = CodeUI.mode
        slotRow.Visible = mode == "plot"
        if mode == "model" then
            local members = modelMembers(CodeUI.mdl)
            if #members == 0 then
                head.Text = "This model no longer exists"
                srcBox.TextEditable = false
                srcBox.Text = ""
                nameBox.Text = ""
                refreshInfo()
                return
            end
            local mine_ = false
            for _, e in ipairs(members) do
                if e.owner == lp.UserId then mine_ = true end
            end
            local root = modelRoot(CodeUI.mdl)
            srcBox.TextEditable = mine_
            srcBox.Text = root and root.st.msrc or ""
            nameBox.Text = members[1].st.mname or "Model"
            head.Text = "Model script  -  runs on the model (" .. #members .. " parts)" .. (mine_ and "" or "  -  view only")
        elseif mode == "plot" then
            if not myPlot then
                head.Text = "Claim a plot first"
                srcBox.TextEditable = false
                srcBox.Text = ""
                nameBox.Text = ""
                refreshInfo()
                return
            end
            local list = plotScripts[myPlot.key]
            local r = list and list[CodeUI.idx]
            srcBox.TextEditable = true
            srcBox.Text = r and r.src or ""
            nameBox.Text = r and r.n or ("Plot script " .. CodeUI.idx)
            head.Text = "Plot script  -  runs for your whole plot"
            for n, b in ipairs(slotBtns) do
                setActive(b, n == CodeUI.idx)
                b.Text = (list and list[n]) and ("Slot " .. n .. "*") or ("Slot " .. n)
            end
        end
        refreshInfo()
    end

    function CodeUI.save()
        local text = srcBox.Text
        local empty = text:match("^%s*$") ~= nil
        if not empty then
            local ok, why = Scripts.check(text)
            if not ok then
                toast(why, true)
                return
            end
        end
        local nm = nameBox.Text
        if CodeUI.mode == "plot" then
            if not myPlot then
                toast("Claim a plot first", true)
                return
            end
            setPlotScript(myPlot.key, CodeUI.idx, nm, (not empty) and text or nil, true)
            local key = CodeUI.key()
            local list = plotScripts[myPlot.key]
            local r = list and list[CodeUI.idx]
            if r then
                r.paused = false
                Scripts.errs[key], Scripts.logs[key] = nil, nil
                Scripts.restart(key)
            end
            toast(empty and "Plot script removed" or "Plot script saved")
        elseif CodeUI.mode == "model" then
            local members = {}
            for _, e in ipairs(modelMembers(CodeUI.mdl)) do
                if e.owner == lp.UserId then members[#members + 1] = e end
            end
            if #members == 0 then
                toast("You don't own this model", true)
                return
            end
            local root = modelRoot(CodeUI.mdl)
            local rootId = (root and root.owner == lp.UserId and root.st.i) or members[1].st.i
            local cleaned = (nm:gsub("[^%w _%-]", "")):sub(1, 24)
            if cleaned == "" then cleaned = "Model" end
            for _, e in ipairs(members) do
                local want = (e.st.i == rootId and not empty) and text or nil
                if e.st.msrc ~= want or e.st.mname ~= cleaned then
                    local st = copy(e.st)
                    st.msrc, st.mname = want, cleaned
                    commit(st)
                end
            end
            local key = "m_" .. CodeUI.mdl
            local i = Scripts.info(key)
            if i then i.state.paused = false end
            Scripts.errs[key], Scripts.logs[key] = nil, nil
            Scripts.restart(key)
            toast(empty and "Model script removed" or "Model script saved")
        end
        CodeUI.load()
    end

    function CodeUI.open(mode, arg)
        if mode == "model" then
            CodeUI.mdl = arg
        else
            CodeUI.idx = math.clamp(CodeUI.idx, 1, nSlots)
        end
        CodeUI.mode = mode
        CodeUI.load()
        if not rec.shown then
            showRec(rec, true)
            play("open")
        end
        setActive(Bld.codeBtn, mode == "plot")
    end

    function CodeUI.close()
        if rec.shown then
            showRec(rec, false)
            play("close")
        end
        setActive(Bld.codeBtn, false)
    end

    task.spawn(function()
        while running do
            task.wait(0.5)
            if rec.shown then refreshInfo() end
        end
    end)
end

