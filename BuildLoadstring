layout = function()
    local cam = workspace.CurrentCamera
    if not cam then return end
    local vp = cam.ViewportSize
    local sc = math.clamp(math.min(vp.X / (math.max(toolbarW, 860) + 30), vp.Y / 720, 1), 0.5, 1)
    for _, rec in ipairs(uiScales) do
        rec.base = sc
        if rec.simple then rec.u.Scale = sc else applyScale(rec) end
    end
    local panelW = math.clamp((vp.X / sc) * 0.27, 320, 390)
    if vp.X < 900 then panelW = math.max(280, math.min(330, vp.X / sc - 24)) end
    local ph = collapsed and 46 or math.max(320, math.min(700, (vp.Y - 170) / sc))
    tween(props, 0.28, { Size = UDim2.fromOffset(panelW, ph) }, Enum.EasingStyle.Quint)
    settings.Size = UDim2.fromOffset(340, math.min(600, (vp.Y - 60) / sc))
    if invRec then invRec.frame.Size = UDim2.fromOffset(330, math.max(240, math.min(470, (vp.Y - 190) / sc))) end
    if Bld.bRec then Bld.bRec.frame.Size = UDim2.fromOffset(280, math.max(200, math.min(300, (vp.Y - 200) / sc))) end
    if Bld.iRec then Bld.iRec.frame.Size = UDim2.fromOffset(300, math.max(220, math.min(330, (vp.Y - 120) / sc))) end
    if scrRec then scrRec.frame.Size = UDim2.fromOffset(430, math.min(520, (vp.Y - 60) / sc)) end
    if CodeUI and CodeUI.rec then CodeUI.rec.frame.Size = UDim2.fromOffset(430, math.max(260, math.min(540, (vp.Y - 60) / sc))) end
    if Bld.pRec then Bld.pRec.frame.Size = UDim2.fromOffset(300, math.max(220, math.min(380, (vp.Y - 120) / sc))) end
end

