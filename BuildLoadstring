local function musicEntryId(entry)
    local value
    if type(entry) == "string" or type(entry) == "number" then value = tostring(entry)
    elseif type(entry) == "table" then value = tostring(entry.id or entry.ID or entry.soundId or entry.SoundId or "")
    else return nil end
    value = value:gsub("^%s+", ""):gsub("%s+$", ""):gsub("^rbxassetid://", "")
    if not value:match("^%d+$") then return nil end
    return "rbxassetid://" .. value
end

local function musicUrl(entry)
    local url = type(entry) == "string" and entry or (type(entry) == "table" and (entry.url or entry.Url) or "")
    if type(url) ~= "string" then return "" end
    -- Convert GitHub's HTML/blob URL into the raw file endpoint.
    url = url:gsub("^https://github%.com/([^/]+)/([^/]+)/blob/", "https://raw.githubusercontent.com/%1/%2/")
    return url
end

local function looksLikeAudio(body)
    if type(body) ~= "string" or #body < 4096 then return false end
    local h3, h4 = body:sub(1, 3), body:sub(1, 4)
    if h3 == "ID3" or h4 == "OggS" or h4 == "RIFF" or h4 == "fLaC" then return true end
    local b1, b2 = body:byte(1, 2)
    return b1 == 0xFF and b2 ~= nil and b2 >= 0xE0 -- MPEG frame sync
end

local function downloadMusic(entry, index)
    local url = musicUrl(entry)
    if not url:match("^https://raw%.githubusercontent%.com/") then return nil end
    if not (writefile and (getcustomasset or getsynasset)) then return nil end
    local name = url:match("/([^/?#]+)$") or ("track_" .. index .. ".mp3")
    name = name:gsub("[^%w%._%-]", "_")
    local folderName = CONFIG.Music.Folder or "Build_music"
    local file = name
    if type(makefolder) == "function" then
        file = folderName .. "/" .. name
        pcall(function() if not (isfolder and isfolder(folderName)) then makefolder(folderName) end end)
    end
    local exists = false
    pcall(function() exists = isfile and isfile(file) end)
    -- A previous failed download (HTML error page, truncated file) would be cached forever; verify and purge it.
    if exists then
        local okRead, data = pcall(readfile, file)
        if not (okRead and looksLikeAudio(data)) then
            pcall(function() if delfile then delfile(file) end end)
            exists = false
        end
    end
    if not exists then
        local body
        for attempt = 1, 2 do
            local ok, response = pcall(httpReq, { Url = url, Method = "GET" })
            if ok and type(response) == "table" and (response.StatusCode == 200 or response.Success == true)
                and looksLikeAudio(response.Body) then
                body = response.Body
                break
            end
            task.wait(0.5)
        end
        if not body then return nil end
        local saved = pcall(writefile, file, body)
        if not saved then return nil end
    end
    local ok, assetId = pcall(function() return (getcustomasset or getsynasset)(file) end)
    return ok and assetId or nil
end

