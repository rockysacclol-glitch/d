function loadMusic()
    if Music.loading or Music.ready then return end
    Music.loading = true
    Music.error = nil
    Music.tracks = {}
    for i, entry in ipairs(CONFIG.Music.DefaultTracks or {}) do
        if not running then break end
        local assetId = downloadMusic(entry, i)
        if assetId then
            local url = musicUrl(entry)
            Music.tracks[#Music.tracks + 1] = { name = url:match("/([^/?#]+)$") or ("Track " .. i), asset = assetId }
        end
    end
    Music.ready = true
    Music.loading = false
    if #Music.tracks == 0 then
        if not (writefile and (getcustomasset or getsynasset)) then
            Music.error = "your executor has no writefile/getcustomasset"
        else
            Music.error = "downloads failed (check HTTP access and the track URLs)"
        end
    elseif running and not Music.worldCustomId and not Music.manualStop then
        Music.Play(Music.PickRandom())
    end
end

