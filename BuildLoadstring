    button(viewC, "View script", function() toggleScript(true) end,
        { Position = UDim2.fromOffset(18, 108), Size = UDim2.new(1, -36, 0, 28) })
    button(viewC, "Run / Stop for me", function() Scripts.toggle(selected) end,
        { Position = UDim2.fromOffset(18, 142), Size = UDim2.new(1, -36, 0, 28) })

    local scroll = new("ScrollingFrame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0,
        ScrollBarThickness = 3, ScrollBarImageColor3 = C.edge, CanvasSize = UDim2.new(), Active = true,
        AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollingDirection = Enum.ScrollingDirection.Y }, pBody)
    new("UIListLayout", { Padding = UDim.new(0, 7), SortOrder = Enum.SortOrder.LayoutOrder }, scroll)
    new("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 14), PaddingTop = UDim.new(0, 10),
        PaddingBottom = UDim.new(0, 14) }, scroll)

    cur = scroll
    orderN = 0

    local refreshers = {}
    local TAGCOL = { Color3.fromRGB(214, 60, 60), Color3.fromRGB(40, 150, 70), Color3.fromRGB(50, 100, 220) }
    local TAGS = { "X", "Y", "Z" }

    local function triple(title, get, set)
        secTitle(title)
        local r = srow(28)
        local boxes = {}
        for k = 1, 3 do
            local _, tb = field(r, "0", cellW(3), function(box)
                local v = tonumber(box.Text)
                if v then edit(function(st) set(st, k, v) end) end
                refreshProps()
            end, TAGS[k], TAGCOL[k])
            boxes[k] = tb
        end
        refreshers[#refreshers + 1] = function(st)
            for k = 1, 3 do
                if not boxes[k]:IsFocused() then boxes[k].Text = fmt(get(st, k)) end
            end
        end
    end

    secTitle("SHAPE")
    do
        local shapeBtns = {}
        local r1, r2 = srow(28), srow(28)
        local function sb(parent, class, text)
            shapeBtns[class] = button(parent, text, function()
                edit(function(st)
                    st.c = class
                    normalize(st)
                end)
            end, { Size = cellW(3) })
        end
        sb(r1, "Block", "Block")
        sb(r1, "Ball", "Ball")
        sb(r1, "Cylinder", "Cylinder")
        sb(r2, "Wedge", "Slope")
        sb(r2, "Corner", "Corner")
        sb(r2, "Truss", "Truss")
        local r3_ = srow(28)
        sb(r3_, "Mesh", "Mesh")
        refreshers[#refreshers + 1] = function(st)
            for c, b in pairs(shapeBtns) do setActive(b, c == st.c) end
        end
    end
    sdiv()

    triple("POSITION  (studs)", function(st, k) return st.cf[k] end, function(st, k, v) st.cf[k] = r3(v) end)
    triple("ROTATION  (degrees)", function(st, k) return math.deg(st.cf[3 + k]) end,
        function(st, k, v) st.cf[3 + k] = r4(math.rad(v)) end)
    triple("SIZE  (studs)", function(st, k) return st.s[k] end, function(st, k, v) st.s[k] = clampS(v) end)
    sdiv()

    secTitle("COLOR")
    do
        local H, Sa, V = 0, 1, 1
        local dragMode = nil

        local cr = srow(28)
        local preview = new("Frame", { Size = UDim2.fromOffset(28, 28), BackgroundColor3 = C.white, BorderSizePixel = 0 }, cr)
        corner(preview, 7)
        stroke(preview, C.edge, 1)
        local _, hexBox = field(cr, "ff3b30", UDim2.new(1, -108, 1, 0), function(tb)
            local h = (tb.Text:gsub("#", "")):lower()
            if h:match("^%x%x%x%x%x%x$") then
                curColor = h
                edit(function(st) st.col = h end)
            else
                toast("Hex colors look like ff8800", true)
                refreshProps()
            end
        end)
        pickBtn = button(cr, "Eyedrop", function() picker.set(not picker.on) end,
            { Size = UDim2.fromOffset(62, 28), TextSize = 11 })

        local svRow = new("Frame", { Size = UDim2.new(1, 0, 0, 112), BackgroundTransparency = 1,
            LayoutOrder = nextO() }, cur)
        local sv = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromHSV(0, 1, 1),
            BorderSizePixel = 0, Active = true }, svRow)
        corner(sv, 8)
        stroke(sv, C.edge, 1)
        local whiteL = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.white, BorderSizePixel = 0 }, sv)
        corner(whiteL, 8)
        new("UIGradient", { Transparency = NumberSequence.new(0, 1) }, whiteL)
        local blackL = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0),
            BorderSizePixel = 0 }, sv)
        corner(blackL, 8)
        new("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(1, 0) }, blackL)
        local cursor = new("Frame", { Size = UDim2.fromOffset(16, 16), AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromScale(1, 0), BackgroundColor3 = C.white, BorderSizePixel = 0, ZIndex = 4 }, sv)
        corner(cursor, 8)
        stroke(cursor, C.white, 2)
        local cs_ = new("UIScale", {}, cursor)

        local hr = new("Frame", { Size = UDim2.new(1, 0, 0, 14), BackgroundColor3 = C.white, BorderSizePixel = 0,
            LayoutOrder = nextO(), Active = true }, cur)
        corner(hr, 7)
        stroke(hr, C.edge, 1)
        do
            local keys = {}
            for k = 0, 6 do keys[#keys + 1] = ColorSequenceKeypoint.new(k / 6, Color3.fromHSV(k / 6, 1, 1)) end
            new("UIGradient", { Color = ColorSequence.new(keys) }, hr)
        end
        local hk = new("Frame", { Size = UDim2.fromOffset(8, 18), AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(0, 0, 0.5, 0), BackgroundColor3 = C.white, BorderSizePixel = 0, ZIndex = 3 }, hr)
        corner(hk, 4)
        stroke(hk, C.ink, 1.5)

        local function paint()
            local c = Color3.fromHSV(H, Sa, V)
            sv.BackgroundColor3 = Color3.fromHSV(H, 1, 1)
            cursor.Position = UDim2.new(Sa, 0, 1 - V, 0)
            cursor.BackgroundColor3 = c
            hk.Position = UDim2.new(H, 0, 0.5, 0)
            preview.BackgroundColor3 = c
        end

        local function fromMouse(x, y)
            if dragMode == "sv" then
                local p, s = sv.AbsolutePosition, sv.AbsoluteSize
                Sa = math.clamp((x - p.X) / s.X, 0, 1)
                V = 1 - math.clamp((y - p.Y) / s.Y, 0, 1)
            else
                local p, s = hr.AbsolutePosition, hr.AbsoluteSize
                H = math.clamp((x - p.X) / s.X, 0, 0.999)
            end
            paint()
            local h = c2hex(Color3.fromHSV(H, Sa, V))
            curColor = h
            edit(function(st) st.col = h end, true)
        end

        local function startDrag(mode, input)
            local e = mine()
            if not e then
                toast("Select one of your parts first", true)
                return
            end
            pushUndo(e.st.i, e.st)
            dragMode = mode
            tween(cs_, 0.12, { Scale = 1.25 }, Enum.EasingStyle.Back)
            fromMouse(input.Position.X, input.Position.Y)
        end

        connect(sv.InputBegan, function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 then startDrag("sv", i) end
        end)
        connect(hr.InputBegan, function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 then startDrag("hue", i) end
        end)
        connect(UIS.InputChanged, function(i)
            if dragMode and i.UserInputType == Enum.UserInputType.MouseMovement then
                fromMouse(i.Position.X, i.Position.Y)
            end
        end)
        connect(UIS.InputEnded, function(i)
            if dragMode and i.UserInputType == Enum.UserInputType.MouseButton1 then
                dragMode = nil
                tween(cs_, 0.15, { Scale = 1 })
            end
        end)

        for rowN = 0, 1 do
            local rr = srow(22)
            for k = 1, 6 do
                local hex = PALETTE[rowN * 6 + k]
                local b = new("TextButton", { Text = "", Size = cellW(6), BackgroundColor3 = hex2c(hex),
                    AutoButtonColor = false, BorderSizePixel = 0 }, rr)
                corner(b, 6)
                stroke(b, C.edge, 1)
                local cs = new("UIScale", {}, b)
                connect(b.MouseEnter, function() tween(cs, 0.12, { Scale = 1.12 }, Enum.EasingStyle.Back) end)
                connect(b.MouseLeave, function() tween(cs, 0.12, { Scale = 1 }) end)
                connect(b.MouseButton1Click, function()
                    play("click")
                    curColor = hex
                    edit(function(st) st.col = hex end)
                end)
            end
        end

        refreshers[#refreshers + 1] = function(st)
            if not dragMode then
                local h, s, v = Color3.toHSV(hex2c(st.col))
                if s > 0.01 and v > 0.01 then H = h end
                Sa, V = s, v
                paint()
            end
            if not hexBox:IsFocused() then hexBox.Text = st.col end
        end
    end
    sdiv()

    secTitle("MATERIAL")
    do
        local mr = srow(28)
        local function cycleMat(d)
            edit(function(st)
                local i = (MATINDEX[st.m] or 1) - 1 + d
                st.m = MATS[i % #MATS + 1]
                curMat = st.m
            end)
        end
        button(mr, "<", function() cycleMat(-1) end, { Size = UDim2.fromOffset(32, 28) })
        local matBox = new("TextLabel", { Size = UDim2.new(1, -76, 1, 0), BackgroundColor3 = C.white, Text = "Plastic",
            TextColor3 = C.ink, Font = Enum.Font.Gotham, TextSize = 12, BorderSizePixel = 0 }, mr)
        corner(matBox, 7)
        stroke(matBox, C.line, 1)
        button(mr, ">", function() cycleMat(1) end, { Size = UDim2.fromOffset(32, 28) })
        refreshers[#refreshers + 1] = function(st) matBox.Text = st.m end
    end
    sdiv()

    secTitle("TRANSPARENCY")
    do
        local tr = srow(22)
        local vis = slider(tr, UDim2.new(1, 0, 1, 0), 0, 1,
            function()
                local e = mine()
                return e and e.st.t or 0
            end,
            function(v)
                local t = math.floor(v * 100 + 0.5) / 100
                edit(function(st) st.t = t end, true)
            end,
            function()
                local e = mine()
                if e then pushUndo(e.st.i, e.st) end
            end)
        refreshers[#refreshers + 1] = function(st)
            vis()
        end
    end
    sdiv()

    do
        local meshC = container()
        local prev = cur
        cur = meshC
        secTitle("MESH")
        local kr = srow(28)
        local function cycleMesh(d)
            edit(function(st)
                local i = (table.find(MESHKINDS, st.mk) or 1) - 1 + d
                st.mk = MESHKINDS[i % #MESHKINDS + 1]
            end)
        end
        button(kr, "<", function() cycleMesh(-1) end, { Size = UDim2.fromOffset(32, 28) })
        local kindBox = new("TextLabel", { Size = UDim2.new(1, -76, 1, 0), BackgroundColor3 = C.white, Text = "Sphere",
            TextColor3 = C.ink, Font = Enum.Font.Gotham, TextSize = 12, BorderSizePixel = 0 }, kr)
        corner(kindBox, 7)
        stroke(kindBox, C.line, 1)
        button(kr, ">", function() cycleMesh(1) end, { Size = UDim2.fromOffset(32, 28) })
        smallLbl("MeshId  (asset number, FileMesh kind)")
        local _, midBox = field(srow(28), "", UDim2.new(1, 0, 1, 0), function(tb)
            edit(function(st) st.mid = digits(tb.Text) end)
            refreshProps()
        end, "M")
        smallLbl("TextureId  (asset number)")
        local _, texBox = field(srow(28), "", UDim2.new(1, 0, 1, 0), function(tb)
            edit(function(st) st.tex = digits(tb.Text) end)
            refreshProps()
        end, "T")
        triple("MESH SCALE", function(st, k) return (st.msc or { 1, 1, 1 })[k] end,
            function(st, k, v)
                st.msc = st.msc or { 1, 1, 1 }
                st.msc[k] = math.clamp(r3(v), 0.01, 100)
            end)
        sdiv()
        cur = prev
        refreshers[#refreshers + 1] = function(st)
            meshC.Visible = st.c == "Mesh"
            kindBox.Text = st.mk or "Sphere"
            if not midBox:IsFocused() then midBox.Text = st.mid or "" end
            if not texBox:IsFocused() then texBox.Text = st.tex or "" end
        end
    end

    secTitle("SURFACES  (right-click = back)")
    do
        local surfBtns = {}
        for pair = 0, 2 do
            local rr = srow(26)
            for j = 1, 2 do
                local k = pair * 2 + j
                surfBtns[k] = button(rr, "", function()
                    edit(function(st) st.f[k] = st.f[k] % #SURF + 1 end)
                end, { Size = cellW(2), TextSize = 11, Right = function()
                    edit(function(st) st.f[k] = (st.f[k] - 2) % #SURF + 1 end)
                end })
            end
        end
        local qr = srow(26)
        button(qr, "All studs", function() edit(function(st) st.f = { 2, 2, 2, 2, 2, 2 } end) end,
            { Size = cellW(2), TextSize = 11 })
        button(qr, "All smooth", function() edit(function(st) st.f = { 1, 1, 1, 1, 1, 1 } end) end,
            { Size = cellW(2), TextSize = 11 })
        refreshers[#refreshers + 1] = function(st)
            for k, b in pairs(surfBtns) do b.Text = FACES[k] .. ": " .. SURFSHORT[st.f[k]] end
        end
    end
    sdiv()

    do
        secTitle("EFFECTS")
        for rowN = 0, 1 do
            local rr = srow(26)
            for k = 1, 4 do
                local key = FXORDER[rowN * 4 + k]
                if key then
                    button(rr, "+" .. FXBTN[key], function()
                        edit(function(st)
                            st.fx = st.fx or {}
                            if #st.fx >= CONFIG.MaxFx then
                                toast("Effect limit reached", true)
                                return
                            end
                            local d = FX[key]
                            st.fx[#st.fx + 1] = { k = key, c = d.col, a = d.a, b = d.b, id = "" }
                        end)
                    end, { Size = cellW(4), TextSize = 10 })
                end
            end
        end
        local fxList = container()
        local fxSig, fxRefs = nil, {}
        refreshers[#refreshers + 1] = function(st)
            local list = st.fx or {}
            local ks = {}
            for _, f in ipairs(list) do ks[#ks + 1] = f.k end
            local sig = table.concat(ks, ",")
            if sig ~= fxSig then
                fxSig = sig
                clearList(fxList)
                fxRefs = {}
                local prev = cur
                cur = fxList
                for idx, f in ipairs(list) do
                    local d = FX[f.k]
                    local hr = srow(24)
                    label(hr, d.n, { Size = UDim2.new(1, -34, 1, 0), Font = Enum.Font.GothamMedium })
                    button(hr, "x", function()
                        edit(function(s) table.remove(s.fx, idx) end)
                    end, { Size = UDim2.fromOffset(26, 24) })
                    local vr = srow(26)
                    local _, hb = field(vr, f.c, d.la and cellW(3) or UDim2.new(1, 0, 1, 0), function(tb)
                        local h = (tb.Text:gsub("#", "")):lower()
                        if h:match("^%x%x%x%x%x%x$") then
                            edit(function(s) s.fx[idx].c = h end)
                        else
                            toast("Hex colors look like ff8800", true)
                            refreshProps()
                        end
                    end, "#")
                    local ab, bb, ib
                    if d.la then
                        local _, a = field(vr, fmt(f.a), cellW(3), function(tb)
                            local v = tonumber(tb.Text)
                            if v then edit(function(s) s.fx[idx].a = v end) end
                            refreshProps()
                        end, d.la:sub(1, 1))
                        local _, b = field(vr, fmt(f.b), cellW(3), function(tb)
                            local v = tonumber(tb.Text)
                            if v then edit(function(s) s.fx[idx].b = v end) end
                            refreshProps()
                        end, d.lb:sub(1, 1))
                        ab, bb = a, b
                    end
                    if d.tex then
                        local _, t = field(srow(26), f.id, UDim2.new(1, 0, 1, 0), function(tb)
                            edit(function(s) s.fx[idx].id = digits(tb.Text) end)
                            refreshProps()
                        end, "T")
                        ib = t
                    end
                    fxRefs[idx] = function(ff)
                        if not hb:IsFocused() then hb.Text = ff.c end
                        if ab and not ab:IsFocused() then ab.Text = fmt(ff.a) end
                        if bb and not bb:IsFocused() then bb.Text = fmt(ff.b) end
                        if ib and not ib:IsFocused() then ib.Text = ff.id end
                    end
                end
                cur = prev
            end
            for idx, f in ipairs(list) do
                if fxRefs[idx] then fxRefs[idx](f) end
            end
        end
    end
    smallLbl("Spark / Fire / Smoke / Light: A and B change with the effect.")
    sdiv()

    do
        secTitle("DECALS & TEXTURES")
        local ar = srow(26)
        local function addDecal(kind)
            edit(function(st)
                st.dec = st.dec or {}
                if #st.dec >= CONFIG.MaxDecals then
                    toast("Decal limit reached", true)
                    return
                end
                st.dec[#st.dec + 1] = { k = kind, f = 5, id = "", tr = 0 }
            end)
        end
        button(ar, "+ Decal", function() addDecal("d") end, { Size = cellW(2), TextSize = 11 })
        button(ar, "+ Texture", function() addDecal("t") end, { Size = cellW(2), TextSize = 11 })
        local decList = container()
        local decSig, decRefs = nil, {}
        refreshers[#refreshers + 1] = function(st)
            local list = st.dec or {}
            local ks = {}
            for _, d in ipairs(list) do ks[#ks + 1] = d.k end
            local sig = table.concat(ks, ",")
            if sig ~= decSig then
                decSig = sig
                clearList(decList)
                decRefs = {}
                local prev = cur
                cur = decList
                for idx, d in ipairs(list) do
                    local hr = srow(24)
                    local fb = button(hr, FACES[d.f], function()
                        edit(function(s) s.dec[idx].f = s.dec[idx].f % 6 + 1 end)
                    end, { Size = UDim2.fromOffset(78, 24), TextSize = 11, Right = function()
                        edit(function(s) s.dec[idx].f = (s.dec[idx].f - 2) % 6 + 1 end)
                    end })
                    label(hr, d.k == "t" and "Texture" or "Decal", { Size = UDim2.new(1, -118, 1, 0), TextSize = 11 })
                    button(hr, "x", function()
                        edit(function(s) table.remove(s.dec, idx) end)
                    end, { Size = UDim2.fromOffset(26, 24) })
                    local vr = srow(26)
                    local _, ib = field(vr, d.id, UDim2.new(1, -62, 1, 0), function(tb)
                        edit(function(s) s.dec[idx].id = digits(tb.Text) end)
                        refreshProps()
                    end, "#")
                    local _, tb2 = field(vr, fmt(d.tr), UDim2.fromOffset(56, 26), function(tb)
                        local v = tonumber(tb.Text)
                        if v then edit(function(s) s.dec[idx].tr = v end) end
                        refreshProps()
                    end, "T")
                    decRefs[idx] = function(dd)
                        fb.Text = FACES[dd.f]
                        if not ib:IsFocused() then ib.Text = dd.id end
                        if not tb2:IsFocused() then tb2.Text = fmt(dd.tr) end
                    end
                end
                cur = prev
            end
            for idx, d in ipairs(list) do
                if decRefs[idx] then decRefs[idx](d) end
            end
        end
        smallLbl("# = image asset number,  T = transparency,  click face to change it")
    end
    sdiv()

    do
        secTitle("PART MUSIC")
        smallLbl("One or more Sound IDs separated by commas. The part plays them in order with 3D distance falloff.")
        local _, partMusicBox = field(srow(28), "", UDim2.new(1, 0, 1, 0), function(tb)
            local ids = cleanMusicList(tb.Text)
            edit(function(st) st.music = ids ~= "" and ids or nil end)
            refreshProps()
        end, "IDs")
        refreshers[#refreshers + 1] = function(st)
            if not partMusicBox:IsFocused() then partMusicBox.Text = st.music or "" end
        end
    end
    sdiv()

    do
        secTitle("SCRIPT")
        local scrStatus = label(cur, "No script", { Size = UDim2.new(1, 0, 0, 30), TextSize = 11, TextWrapped = true,
            TextYAlignment = Enum.TextYAlignment.Top, LayoutOrder = nextO() })
        local sr = srow(28)
        button(sr, "Open editor", function() toggleScript(true) end, { Size = cellW(2) })
        button(sr, "Run / Stop", function() Scripts.toggle(selected) end, { Size = cellW(2) })
        refreshers[#refreshers + 1] = function(st)
            scrStatus.Text = Scripts.status(st.i)
        end
    end
    sdiv()

    do
        local rr = srow(30)
        button(rr, "Tilt up (T)", function() rotateSel(90, "up") end, { Size = cellW(2), TextSize = 11 })
        button(rr, "Rotate (R)", function() rotateSel(90) end, { Size = cellW(2), TextSize = 11 })
        local ar = srow(30)
        button(ar, "Duplicate", duplicate, { Size = cellW(2) })
        button(ar, "Delete", deleteSelected, { Size = cellW(2) })
    end

    refreshProps = function()
        local e = mine()
        local sel = selected and all[selected]
        local onPartTab = currentSideTab == nil or currentSideTab == "Part"
        scroll.Visible = onPartTab and e ~= nil and not collapsed
        emptyLbl.Visible = onPartTab and (sel == nil) and not collapsed
        viewC.Visible = onPartTab and (sel ~= nil and e == nil) and not collapsed
        pBody.Visible = not collapsed
        if e then
            pSub.Text = e.st.c .. "  -  " .. e.st.i:sub(1, 4)
        elseif sel then
            pSub.Text = "Owned by " .. (peers[sel.owner] or tostring(sel.owner))
            viewInfo.Text = "Owned by " .. (peers[sel.owner] or tostring(sel.owner)) .. " (view only)"
            viewStat.Text = Scripts.status(selected)
        else
            pSub.Text = "Nothing selected"
        end
        if not e then return end
        for _, fn in ipairs(refreshers) do fn(e.st) end
    end
end
buildPropertiesPanel()

settings = new("CanvasGroup", { Name = "Settings", AnchorPoint = Vector2.new(0.5, 0.5),
