fc = { on = false, rmb = false, speed = 40, yaw = 0, pitch = 0, pos = Vector3.zero }
do
    local controlsObj

    local function setControls(en)
        pcall(function()
            if not controlsObj then
                controlsObj = require(lp:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule", 3)):GetControls()
            end
            if en then controlsObj:Enable() else controlsObj:Disable() end
        end)
    end

    local function fcStep(dt)
        if not fc.on then return end
        local cam = workspace.CurrentCamera
        if cam.CameraType ~= Enum.CameraType.Scriptable then cam.CameraType = Enum.CameraType.Scriptable end
        local move = Vector3.zero
        if not UIS:GetFocusedTextBox() then
            local function k(c) return UIS:IsKeyDown(c) end
            if k(Enum.KeyCode.W) then move += Vector3.new(0, 0, -1) end
            if k(Enum.KeyCode.S) then move += Vector3.new(0, 0, 1) end
            if k(Enum.KeyCode.A) then move += Vector3.new(-1, 0, 0) end
            if k(Enum.KeyCode.D) then move += Vector3.new(1, 0, 0) end
            if k(Enum.KeyCode.Space) then move += Vector3.new(0, 1, 0) end
            if k(Enum.KeyCode.Q) then move += Vector3.new(0, -1, 0) end
        end
        local rot = CFrame.fromOrientation(fc.pitch, fc.yaw, 0)
        if move.Magnitude > 0 then
            move = move.Unit
            local speed = fc.speed * (UIS:IsKeyDown(Enum.KeyCode.LeftShift) and 3 or 1)
            fc.pos += (rot:VectorToWorldSpace(Vector3.new(move.X, 0, move.Z)) + Vector3.new(0, move.Y, 0)) * speed * dt
        end
        cam.CFrame = cam.CFrame:Lerp(CFrame.new(fc.pos) * rot, 1 - math.exp(-16 * dt))
    end

    local function setFreecam(on)
        if fc.on == on then return end
        local cam = workspace.CurrentCamera
        fc.on = on
        if on then
            fc.prevType = cam.CameraType
            local rx, ry = cam.CFrame:ToOrientation()
            fc.pitch, fc.yaw, fc.pos = rx, ry, cam.CFrame.Position
            cam.CameraType = Enum.CameraType.Scriptable
            setControls(false)
            RunService:BindToRenderStep("BuildFreecam", Enum.RenderPriority.Camera.Value + 1, fcStep)
            toast("Freecam on - hold right mouse to look, WASD / Space / Q to fly")
        else
            pcall(function() RunService:UnbindFromRenderStep("BuildFreecam") end)
            fc.rmb = false
            UIS.MouseBehavior = Enum.MouseBehavior.Default
            setControls(true)
            cam.CameraType = fc.prevType or Enum.CameraType.Custom
            toast("Freecam off")
        end
        setActive(freecamBtn, on)
        play(on and "open" or "close")
    end

    fc.set = setFreecam
    toggleFreecam = function() setFreecam(not fc.on) end
end

connect(UIS.InputBegan, function(input, processed)
    if processed then return end
    local ut = input.UserInputType
    if ut == Enum.UserInputType.MouseButton1 then
        if picker.on then
            picker.click()
            return
        end
        if not editorOpen or overHandle() then return end
        local t = mouse.Target
        local id = t and t:GetAttribute("NB")
        local shift = UIS:IsKeyDown(Enum.KeyCode.LeftShift)
        local ctrl = UIS:IsKeyDown(Enum.KeyCode.LeftControl)
        local alt = UIS:IsKeyDown(Enum.KeyCode.LeftAlt)
        if id and all[id] and not alt then
            if shift then
                toggleInSelection(id)
                return
            elseif ctrl then
                selectMany({ id }, id)
            elseif msel[id] and selCount() > 1 then
                select_(id, true)
            else
                local ids = expandModel(id)
                if #ids > 1 then selectMany(ids, id) else select_(id) end
            end
            local e = mine()
            if e and (tool == "select" or tool == "move") then
                local hit = planeHit(mouse.UnitRay, e.st.cf[2])
                if hit then
                    local group = {}
                    for _, gid in ipairs(mineSelIds()) do
                        if gid ~= id then group[#group + 1] = { id = gid, base = copy(all[gid].st) } end
                    end
                    pdrag = {
                        id = id, base = copy(e.st), pushed = false, active = false, last = nil, group = group,
                        off = Vector3.new(e.st.cf[1] - hit.X, 0, e.st.cf[3] - hit.Z),
                        startM = UIS:GetMouseLocation(),
                    }
                end
            end
        else
            if not shift then select_(nil) end
            mq = { start = UIS:GetMouseLocation(), additive = shift, active = false }
        end
    elseif ut == Enum.UserInputType.MouseButton2 then
        if fc.on then
            fc.rmb = true
            UIS.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
        end
    elseif input.KeyCode == CONFIG.ToggleKey then
        local on = not gui.Enabled
        gui.Enabled = on
        hgui.Enabled = on
        selBox.Visible = on
        for _, b in pairs(selBoxes) do b.Visible = on end
        refreshSelBar()
    elseif input.KeyCode == CONFIG.FreecamKey then
        toggleFreecam()
    elseif not editorOpen then
        return
    elseif input.KeyCode == CONFIG.InventoryKey then
        toggleInventory()
    elseif input.KeyCode == Enum.KeyCode.I then
        picker.set(not picker.on)
    elseif input.KeyCode == Enum.KeyCode.Escape and picker.on then
        picker.set(false)
    elseif input.KeyCode == CONFIG.ToolKey then
        cycleTool(UIS:IsKeyDown(Enum.KeyCode.LeftShift) and -1 or 1)
    elseif input.KeyCode == Enum.KeyCode.R and not UIS:IsKeyDown(Enum.KeyCode.LeftControl) then
        rotateSel(UIS:IsKeyDown(Enum.KeyCode.LeftShift) and -90 or 90)
    elseif input.KeyCode == Enum.KeyCode.T and not UIS:IsKeyDown(Enum.KeyCode.LeftControl) then
        rotateSel(UIS:IsKeyDown(Enum.KeyCode.LeftShift) and -90 or 90, "up")
    elseif input.KeyCode == Enum.KeyCode.X and (UIS:IsKeyDown(Enum.KeyCode.LeftShift) or UIS:IsKeyDown(Enum.KeyCode.RightShift)) then
        deleteSelected()
    elseif input.KeyCode == Enum.KeyCode.Delete then
        deleteSelected()
    elseif input.KeyCode == Enum.KeyCode.Z and UIS:IsKeyDown(Enum.KeyCode.LeftControl) then
        undo()
    elseif input.KeyCode == Enum.KeyCode.D and UIS:IsKeyDown(Enum.KeyCode.LeftControl) then
        duplicate()
    elseif input.KeyCode == Enum.KeyCode.A and UIS:IsKeyDown(Enum.KeyCode.LeftControl) then
        selectAllMine()
    elseif input.KeyCode == Enum.KeyCode.G and UIS:IsKeyDown(Enum.KeyCode.LeftControl) then
        groupSelected()
    elseif input.KeyCode == Enum.KeyCode.U and UIS:IsKeyDown(Enum.KeyCode.LeftControl) then
        ungroupSelected()
    end
end)

connect(UIS.InputChanged, function(input, processed)
    if not fc.on then return end
    if input.UserInputType == Enum.UserInputType.MouseMovement and fc.rmb then
        fc.yaw -= input.Delta.X * 0.003
        fc.pitch = math.clamp(fc.pitch - input.Delta.Y * 0.003, -1.55, 1.55)
    elseif input.UserInputType == Enum.UserInputType.MouseWheel and not processed then
        fc.speed = math.clamp(fc.speed * (1.15 ^ input.Position.Z), 4, 400)
        toast("Freecam speed: " .. math.floor(fc.speed))
    end
end)

connect(UIS.InputEnded, function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        pdrag = nil
        tf = nil
        finishMarquee()
    elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
        fc.rmb = false
        if UIS.MouseBehavior == Enum.MouseBehavior.LockCurrentPosition then
            UIS.MouseBehavior = Enum.MouseBehavior.Default
        end
    end
end)

connect(RunService.RenderStepped, function()
    if not pdrag then return end
    local e = all[pdrag.id]
    if not e then
        pdrag = nil
        return
    end
    if not pdrag.active then
        if (UIS:GetMouseLocation() - pdrag.startM).Magnitude < 5 then return end
        pdrag.active = true
    end
    local hit = planeHit(mouse.UnitRay, pdrag.base.cf[2])
    if not hit then return end
    local x = snapv(hit.X + pdrag.off.X, S.move)
    local z = snapv(hit.Z + pdrag.off.Z, S.move)
    if pdrag.last and pdrag.last.x == x and pdrag.last.z == z then return end
    if not pdrag.pushed then
        if #pdrag.group > 0 then
            local states = { pdrag.base }
            for _, g in ipairs(pdrag.group) do states[#states + 1] = g.base end
            pushUndoMulti(states)
        else
            pushUndo(pdrag.id, pdrag.base)
        end
        pdrag.pushed = true
    end
    pdrag.last = { x = x, z = z }
    play("tick")
    local st = copy(e.st)
    st.cf[1] = x
    st.cf[3] = z
    commit(st)
    local dx, dz = x - pdrag.base.cf[1], z - pdrag.base.cf[3]
    for _, g in ipairs(pdrag.group) do
        local gs = copy(g.base)
        gs.cf[1] = r3(gs.cf[1] + dx)
        gs.cf[3] = r3(gs.cf[3] + dz)
        commit(gs)
    end
    refreshProps()
end)

