tf = nil

function overHandle()
    for _, v in pairs(hovering) do
        if v then return true end
    end
    return false
end

do
    local AX = {
        { faces = { Enum.NormalId.Right, Enum.NormalId.Left }, axis = Enum.Axis.X, color = Color3.fromRGB(240, 80, 80) },
        { faces = { Enum.NormalId.Top, Enum.NormalId.Bottom }, axis = Enum.Axis.Y, color = Color3.fromRGB(70, 200, 110) },
        { faces = { Enum.NormalId.Back, Enum.NormalId.Front }, axis = Enum.Axis.Z, color = Color3.fromRGB(80, 130, 245) },
    }
    local moveH, scaleH, rotH = {}, {}, {}

    local function axisIndex(n)
        if math.abs(n.X) > 0.5 then return 1 end
        if math.abs(n.Y) > 0.5 then return 2 end
        return 3
    end

    local function trackHover(h)
        connect(h.MouseEnter, function() hovering[h] = true end)
        connect(h.MouseLeave, function() hovering[h] = false end)
    end

    local function axisMouseParameter(camera, mousePosition, origin, axisWorld)
        local axis = axisWorld.Unit
        local ray = camera:ScreenPointToRay(mousePosition.X, mousePosition.Y)
        local rayDirection = ray.Direction.Unit
        local offset = origin - ray.Origin
        local alignment = axis:Dot(rayDirection)
        local denominator = 1 - alignment * alignment
        if denominator < 0.000001 then return nil end
        local axisOffset = axis:Dot(offset)
        local rayOffset = rayDirection:Dot(offset)
        return (alignment * rayOffset - axisOffset) / denominator
    end

    local function screenAxisDistance(base, axisWorld, startMouse, fallback)
        local camera = workspace.CurrentCamera
        if not camera or axisWorld.Magnitude < 0.000001 then return fallback end
        local origin = base.Position
        local currentMouse = UIS:GetMouseLocation()
        local startParameter = axisMouseParameter(camera, startMouse, origin, axisWorld)
        local currentParameter = axisMouseParameter(camera, currentMouse, origin, axisWorld)
        if startParameter and currentParameter then
            return currentParameter - startParameter
        end

        local p0 = camera:WorldToScreenPoint(origin)
        local p1 = camera:WorldToScreenPoint(origin + axisWorld.Unit)
        local screenAxis = Vector2.new(p1.X - p0.X, p1.Y - p0.Y)
        local length = screenAxis.Magnitude
        if length < 0.0001 then return fallback end
        return (currentMouse - startMouse):Dot(screenAxis / length) / length
    end

    local function beginTransform()
        local e = mine()
        if not e then return end
        tf = { base = copy(e.st), last = nil, group = {}, startMouse = UIS:GetMouseLocation() }
        local states = { e.st }
        for _, id in ipairs(mineSelIds()) do
            local o = all[id]
            if o and id ~= e.st.i then
                tf.group[#tf.group + 1] = { id = id, base = copy(o.st) }
                states[#states + 1] = o.st
            end
        end
        if #states > 1 then pushUndoMulti(states) else pushUndo(e.st.i, e.st) end
    end

    for _, a in ipairs(AX) do
        local h = Instance.new("Handles")
        h.Style = Enum.HandlesStyle.Movement
        h.Faces = Faces.new(a.faces[1], a.faces[2])
        h.Color3 = a.color
        h.Parent = hgui
        moveH[#moveH + 1] = h
        trackHover(h)
        connect(h.MouseButton1Down, beginTransform)
        connect(h.MouseButton1Up, function() tf = nil end)
        connect(h.MouseDrag, function(face, dist)
            if not tf then return end
            local normal = decCF(tf.base.cf):VectorToWorldSpace(Vector3.FromNormalId(face))
            local d = snapv(screenAxisDistance(decCF(tf.base.cf), normal, tf.startMouse, dist), S.move)
            if tf.last == d then return end
            tf.last = d
            play("tick")
            local st = copy(tf.base)
            local off = decCF(tf.base.cf):VectorToWorldSpace(Vector3.FromNormalId(face) * d)
            st.cf[1] = r3(tf.base.cf[1] + off.X)
            st.cf[2] = r3(tf.base.cf[2] + off.Y)
            st.cf[3] = r3(tf.base.cf[3] + off.Z)
            commit(st)
            for _, g in ipairs(tf.group) do
                local gs = copy(g.base)
                gs.cf[1] = r3(gs.cf[1] + off.X)
                gs.cf[2] = r3(gs.cf[2] + off.Y)
                gs.cf[3] = r3(gs.cf[3] + off.Z)
                commit(gs)
            end
            refreshProps()
        end)

        local sh = Instance.new("Handles")
        sh.Style = Enum.HandlesStyle.Resize
        sh.Faces = Faces.new(a.faces[1], a.faces[2])
        sh.Color3 = a.color
        sh.Parent = hgui
        scaleH[#scaleH + 1] = sh
        trackHover(sh)
        connect(sh.MouseButton1Down, beginTransform)
        connect(sh.MouseButton1Up, function() tf = nil end)
        connect(sh.MouseDrag, function(face, dist)
            if not tf then return end
            local base = tf.base
            local n = Vector3.FromNormalId(face)
            local worldNormal = decCF(base.cf):VectorToWorldSpace(n)
            dist = screenAxisDistance(decCF(base.cf), worldNormal, tf.startMouse, dist)
            local k = axisIndex(n)
            local sym = UIS:IsKeyDown(Enum.KeyCode.LeftControl)
            local uni = UIS:IsKeyDown(Enum.KeyCode.LeftShift)
            local st = copy(base)
            local key
            if uni then
                local target = math.max(0.05, snapv(base.s[k] + dist, S.scale))
                local f = target / base.s[k]
                for i = 1, 3 do st.s[i] = clampS(base.s[i] * f) end
                key = "u" .. target
            else
                local target = clampS(snapv(base.s[k] + (sym and dist * 2 or dist), S.scale))
                st.s[k] = target
                if not sym then
                    local applied = target - base.s[k]
                    local off = decCF(base.cf):VectorToWorldSpace(n * (applied / 2))
                    st.cf[1] = r3(base.cf[1] + off.X)
                    st.cf[2] = r3(base.cf[2] + off.Y)
                    st.cf[3] = r3(base.cf[3] + off.Z)
                end
                key = (sym and "c" or "n") .. target
            end
            if tf.last == key then return end
            tf.last = key
            play("tick")
            commit(st)
            refreshProps()
        end)

        local ah = Instance.new("ArcHandles")
        ah.Axes = Axes.new(a.axis)
        ah.Color3 = a.color
        ah.Parent = hgui
        rotH[#rotH + 1] = ah
        trackHover(ah)
        connect(ah.MouseButton1Down, beginTransform)
        connect(ah.MouseButton1Up, function() tf = nil end)
        connect(ah.MouseDrag, function(axis, rel)
            if not tf then return end
            local deg = math.deg(rel)
            if S.rot > 0 then deg = math.floor(deg / S.rot + 0.5) * S.rot end
            if tf.last == deg then return end
            tf.last = deg
            play("tick")
            local st = copy(tf.base)
            st.cf = encCF(decCF(tf.base.cf) * CFrame.fromAxisAngle(Vector3.FromAxis(axis), math.rad(deg)))
            commit(st)
            if #tf.group > 0 then
                local pivot = decCF(tf.base.cf).Position
                local axisW = decCF(tf.base.cf):VectorToWorldSpace(Vector3.FromAxis(axis))
                local Rw = CFrame.fromAxisAngle(axisW, math.rad(deg))
                for _, g in ipairs(tf.group) do
                    local gs = copy(g.base)
                    gs.cf = encCF(CFrame.new(pivot) * Rw * CFrame.new(-pivot) * decCF(g.base.cf))
                    commit(gs)
                end
            end
            refreshProps()
        end)
    end

    updateHandles = function()
        local e = editorOpen and mine() or nil
        local inst = e and e.inst or nil
        for k in pairs(hovering) do hovering[k] = false end
        for _, h in ipairs(moveH) do h.Adornee = (tool == "move") and inst or nil end
        for _, h in ipairs(scaleH) do h.Adornee = (tool == "scale") and inst or nil end
        for _, h in ipairs(rotH) do h.Adornee = (tool == "rotate") and inst or nil end
    end
end

select_ = function(id, keepMulti)
    local changed = selected ~= id
    if not keepMulti then
        msel = {}
        if id then msel[id] = true end
    elseif id then
        msel[id] = true
    end
    selected = id
    local e = id and all[id]
    selBox.Adornee = e and e.inst or nil
    if changed and e then
        selBox.LineThickness = 0.1
        selBox.SurfaceTransparency = 0.55
        tween(selBox, 0.35, { LineThickness = 0.045, SurfaceTransparency = 0.88 }, Enum.EasingStyle.Quint)
    end
    updateHandles()
    refreshProps()
    scriptOnSelect()
    refreshMultiBoxes()
    if changed and e then play("select") end
    if e and e.owner ~= lp.UserId then
        toast("Owned by " .. (peers[e.owner] or tostring(e.owner)) .. " (view only)")
    end
end

function planeHit(ray, y)
    if math.abs(ray.Direction.Y) < 0.01 then return nil end
    local t = (y - ray.Origin.Y) / ray.Direction.Y
    if t < 0 or t > 2000 then return nil end
    return ray.Origin + ray.Direction * t
end

