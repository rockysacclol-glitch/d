        if customIds ~= "" then
            if not Music.manualStop and (Music.worldPlaylistKey ~= customIds or not Music.sound.IsPlaying) then Music.PlayIds(customIds) end
        elseif Music.worldCustomId then
            Music.worldCustomId = nil
            Music.playlist = nil
            Music.worldPlaylistKey = nil
            if #Music.tracks > 0 then Music.Play(Music.PickRandom()) else Music.Stop() end
        else
            Music.EnsureDefault()
        end
    elseif key then
        Music.EnsureDefault()
    else
        local hadCustom = Music.worldCustomId ~= nil
        Music.worldCustomId = nil
        Music.worldPlaylistKey = nil
        if #Music.tracks > 0 then
            if hadCustom or Music.playlist then Music.Play(Music.PickRandom()) else Music.EnsureDefault() end
        end
    end
end

