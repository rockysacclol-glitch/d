function modelMembers(mdl)
    local out = {}
    if not mdl then return out end
    for _, e in pairs(all) do
        if e.st.mdl == mdl then out[#out + 1] = e end
    end
    table.sort(out, function(a, b) return a.st.i < b.st.i end)
    return out
end

function modelRoot(mdl)
    local best
    for _, e in pairs(all) do
        if e.st.mdl == mdl and e.st.msrc and (not best or e.st.i < best.st.i) then best = e end
    end
    return best
end

function expandModel(id)
    local e = all[id]
    if e and e.st.mdl then
        local out = {}
        for _, m in ipairs(modelMembers(e.st.mdl)) do out[#out + 1] = m.st.i end
