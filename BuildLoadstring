function slider(parent, size, min, max, get, set, onBegin, onEnd)
    local numberWidth = 52
    local track = new("Frame", { Size = UDim2.new(size.X.Scale, size.X.Offset - numberWidth - 6, size.Y.Scale, size.Y.Offset),
        Position = UDim2.new(0, 0, 0, 0), BackgroundColor3 = C.white, BorderSizePixel = 0, Active = true }, parent)
    corner(track, 8)
    stroke(track, C.line, 1)
    local fill = new("Frame", { Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = C.accent, BorderSizePixel = 0 }, track)
    corner(fill, 8)
    local knob = new("Frame", { Size = UDim2.fromOffset(16, 16), AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0), BackgroundColor3 = C.white, BorderSizePixel = 0, ZIndex = 3 }, track)
    corner(knob, 8)
    stroke(knob, C.accentDark, 2)
    local ks = new("UIScale", {}, knob)
    local numberBox, numberStroke
    local numberFrame = new("Frame", { Size = UDim2.new(0, numberWidth, size.Y.Scale, size.Y.Offset),
        Position = UDim2.new(1, -numberWidth, 0, 0), BackgroundColor3 = C.white, BorderSizePixel = 0 }, parent)
    corner(numberFrame, 7)
    numberStroke = stroke(numberFrame, C.line, 1)
    numberBox = new("TextBox", { Size = UDim2.new(1, -8, 1, 0), Position = UDim2.fromOffset(4, 0),
        BackgroundTransparency = 1, Text = "", TextColor3 = C.ink, Font = Enum.Font.GothamMedium,
        TextSize = 11, ClearTextOnFocus = false, TextXAlignment = Enum.TextXAlignment.Center }, numberFrame)

    local function cleanNumber(v)
        if math.abs(v - math.floor(v + 0.5)) < 0.000001 then
            return tostring(math.floor(v + 0.5))
        end
        local text = string.format("%.3f", v):gsub("0+$", ""):gsub("%.$", "")
        return text
    end

    local function updateNumber()
        if not numberBox:IsFocused() then numberBox.Text = cleanNumber(get()) end
    end

    local function visual()
        local a = math.clamp((get() - min) / (max - min), 0, 1)
        fill.Size = UDim2.new(a, 0, 1, 0)
        knob.Position = UDim2.new(a, 0, 0.5, 0)
        updateNumber()
    end

    local dragging = false
    local function fromX(x)
        local w = track.AbsoluteSize.X
        if w <= 0 then return end
        local a = math.clamp((x - track.AbsolutePosition.X) / w, 0, 1)
        set(min + (max - min) * a)
        visual()
    end

    connect(numberBox.Focused, function()
        tween(numberStroke, 0.12, { Color = C.accentDark, Thickness = 1.5 })
    end)
    connect(numberBox.FocusLost, function(enterPressed)
        tween(numberStroke, 0.12, { Color = C.line, Thickness = 1 })
        local value = tonumber(numberBox.Text)
        if value and value == value then
            value = math.clamp(value, min, max)
            if onBegin then onBegin() end
            set(value)
            visual()
            if onEnd then onEnd() end
        else
            visual()
        end
    end)

    connect(track.InputBegan, function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            tween(ks, 0.12, { Scale = 1.3 }, Enum.EasingStyle.Back)
            if onBegin then onBegin() end
            fromX(i.Position.X)
        end
    end)
    connect(UIS.InputChanged, function(i)
        if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then fromX(i.Position.X) end
    end)
    connect(UIS.InputEnded, function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 and dragging then
            dragging = false
            tween(ks, 0.15, { Scale = 1 })
            if onEnd then onEnd() end
        end
    end)
    visual()
    return visual
end

function toggle(parent, get, set)
    local b = new("TextButton", { Text = "", Size = UDim2.fromOffset(42, 24), BackgroundColor3 = C.white,
