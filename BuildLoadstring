function r3(v) return math.floor(v * 1000 + 0.5) / 1000 end
function r4(v) return math.floor(v * 10000 + 0.5) / 10000 end
function fmt(v) return tostring(math.floor(v * 100 + 0.5) / 100) end
function snapv(v, inc)
    if not inc or inc <= 0 then return r3(v) end
    return r3(math.floor(v / inc + 0.5) * inc)
end
function clampS(v) return math.clamp(r3(v), 0.05, 2048) end
function encCF(cf)
    local rx, ry, rz = cf:ToEulerAnglesYXZ()
    local p = cf.Position
    return { r3(p.X), r3(p.Y), r3(p.Z), r4(rx), r4(ry), r4(rz) }
end
function decCF(a)
