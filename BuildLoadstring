function Music.PlayIds(value)
    local ids = {}
    local seen = {}
    for token in tostring(value or ""):gmatch("%d+") do
        if #token <= 15 and not seen[token] and #ids < 8 then
            seen[token] = true
            ids[#ids + 1] = "rbxassetid://" .. token
        end
    end
    if #ids == 0 then return false end
    Music.manualStop = false
    Music.playlist = ids
    Music.playlistIndex = 1
    Music.worldPlaylistKey = cleanMusicList(value)
    Music.worldCustomId = ids[1]
    Music.current = 0
    Music.lastStart = os.clock()
    stopDefaultThemes()
    Music.sound:Stop()
    Music.sound.Looped = #ids == 1
    Music.sound.SoundId = ids[1]
    Music.sound.TimePosition = 0
    Music.sound:Play()
    return true
end

function Music.PlayId(value)
    return Music.PlayIds(value)
end

function Music.Play(index)
    if #Music.tracks == 0 then return false end
    Music.manualStop = false
    Music.playlist = nil
    Music.playlistIndex = 0
    Music.worldPlaylistKey = nil
    Music.worldCustomId = nil
    index = math.clamp(math.floor(tonumber(index) or 1), 1, #Music.tracks)
    local track = Music.tracks[index]
    if not track or not track.asset then return false end
    Music.current = index
    Music.lastStart = os.clock()
    stopDefaultThemes()
    Music.sound.Looped = false
    Music.sound:Stop()
    Music.sound.SoundId = track.asset
    Music.sound.TimePosition = 0
    Music.sound:Play()
    return true
end

-- Starts the default playlist only if nothing is playing AND the last start attempt has had time to load.
-- (Previously this was re-triggered every 0.5s, which kept resetting the sound before it could ever play.)
function Music.PickRandom()
    local n = #Music.tracks
    if n <= 1 then return 1 end
    local i = math.random(1, n - 1)
    if i >= Music.current and Music.current > 0 then i += 1 end
    return i
end

function Music.EnsureDefault()
    if #Music.tracks == 0 or Music.manualStop then return end
    if Music.sound.IsPlaying then
        Music.fail = 0
        return
    end
    if os.clock() - (Music.lastStart or 0) < 12 then return end
    local idx = Music.PickRandom() -- shuffle; also moves on if the last pick never started
    Music.fail = (Music.fail or 0) + 1
    Music.Play(idx)
end

function Music.Next()
    if Music.playlist and #Music.playlist > 0 then
        Music.playlistIndex = Music.playlistIndex % #Music.playlist + 1
        local id = Music.playlist[Music.playlistIndex]
        stopDefaultThemes()
        Music.sound:Stop()
        Music.sound.Looped = #Music.playlist == 1
        Music.sound.SoundId = id
        Music.sound.TimePosition = 0
        Music.sound:Play()
        return true
    end
    if #Music.tracks == 0 then return false end
    return Music.Play(Music.PickRandom())
end

function Music.GetCurrent()
    if Music.playlist and Music.playlistIndex > 0 then
        return Music.sound.IsPlaying and ("Sound " .. Music.playlist[Music.playlistIndex]:gsub("rbxassetid://", "")) or nil
    end
    local track = Music.tracks[Music.current]
    return Music.sound.IsPlaying and track and track.name or nil
end

