function nums(t, n)
    if type(t) ~= "table" then return false end
    for i = 1, n do
        if type(t[i]) ~= "number" or t[i] ~= t[i] or math.abs(t[i]) > 1e6 then return false end
    end
    return true
end
function valid(st)
    return type(st.i) == "string" and #st.i <= 16 and CLASSSET[st.c] and nums(st.cf, 6) and nums(st.s, 3)
        and type(st.col) == "string" and st.col:match("^%x%x%x%x%x%x$") ~= nil
        and type(st.t) == "number" and nums(st.f, 6)
        and type(st.plot) == "string" and #st.plot <= 32
        and (st.music == nil or (type(st.music) == "string" and #st.music <= 160 and cleanMusicList(st.music) == st.music))
end

function digits(s)
    local d = tostring(s or ""):match("%d+")
    if d and #d <= 15 then return d end
    return ""
end

function cleanFx(list)
    local out = {}
    if type(list) ~= "table" then return out end
    for _, f in ipairs(list) do
        if #out >= CONFIG.MaxFx then break end
        local d = type(f) == "table" and FX[f.k]
        if d and type(f.c) == "string" and f.c:match("^%x%x%x%x%x%x$") and type(f.a) == "number"
            and type(f.b) == "number" and f.a == f.a and f.b == f.b then
            out[#out + 1] = { k = f.k, c = f.c:lower(), a = math.clamp(f.a, d.amin, d.amax),
                b = math.clamp(f.b, d.bmin, d.bmax), id = digits(f.id) }
        end
    end
    return out
end

function cleanDecals(list)
    local out = {}
    if type(list) ~= "table" then return out end
    for _, d in ipairs(list) do
        if #out >= CONFIG.MaxDecals then break end
        if type(d) == "table" and (d.k == "d" or d.k == "t") and type(d.f) == "number" and d.f >= 1 and d.f <= 6
            and type(d.tr) == "number" and d.tr == d.tr then
            out[#out + 1] = { k = d.k, f = math.floor(d.f), id = digits(d.id), tr = math.clamp(d.tr, 0, 1) }
        end
    end
    return out
end

function cleanMusicList(value)
    local out, seen = {}, {}
    for token in tostring(value or ""):gmatch("%d+") do
        if #token <= 15 and not seen[token] and #out < 8 then
            seen[token] = true
            out[#out + 1] = token
        end
    end
    return table.concat(out, ",")
end

function normalize(st)
    st.music = cleanMusicList(st.music)
    if st.music == "" then st.music = nil end
    st.fx = cleanFx(st.fx)
    if #st.fx == 0 then st.fx = nil end
    st.dec = cleanDecals(st.dec)
    if #st.dec == 0 then st.dec = nil end
    if st.c == "Mesh" then
        if not MESHSET[st.mk] then st.mk = "Sphere" end
        st.mid = digits(st.mid)
        st.tex = digits(st.tex)
        if nums(st.msc, 3) then
            for i = 1, 3 do st.msc[i] = math.clamp(r3(st.msc[i]), 0.01, 100) end
        else
            st.msc = { 1, 1, 1 }
        end
    else
        st.mk, st.mid, st.tex, st.msc = nil, nil, nil, nil
    end
    if type(st.src) ~= "string" or st.src == "" or #st.src > CONFIG.Scripts.MaxSource then st.src = nil end
    if type(st.mdl) ~= "string" or #st.mdl == 0 or #st.mdl > 16 or not st.mdl:match("^[%w_]+$") then
        st.mdl, st.mname, st.msrc = nil, nil, nil
    else
        st.mname = type(st.mname) == "string" and ((st.mname:gsub("[^%w _%-]", "")):sub(1, 24)) or "Model"
        if st.mname == "" then st.mname = "Model" end
        if type(st.msrc) ~= "string" or st.msrc == "" or #st.msrc > CONFIG.Scripts.MaxSource then st.msrc = nil end
    end
    return st
end

