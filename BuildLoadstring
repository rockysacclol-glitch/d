mq = nil

do
    marquee = new("Frame", { Name = "Marquee", BackgroundColor3 = C.accent, BackgroundTransparency = 0.8,
        BorderSizePixel = 0, Visible = false, ZIndex = 60, Active = false }, gui)
    stroke(marquee, C.accentDark, 1)

    connect(RunService.RenderStepped, function()
        if not mq then
            marquee.Visible = false
            return
        end
        local loc = UIS:GetMouseLocation()
        if not mq.active then
            if (loc - mq.start).Magnitude < 6 then return end
            mq.active = true
        end
        local x1, y1 = math.min(mq.start.X, loc.X), math.min(mq.start.Y, loc.Y)
        local x2, y2 = math.max(mq.start.X, loc.X), math.max(mq.start.Y, loc.Y)
        marquee.Position = UDim2.fromOffset(x1, y1)
        marquee.Size = UDim2.fromOffset(x2 - x1, y2 - y1)
        marquee.Visible = true
    end)

    function finishMarquee()
        local m = mq
        mq = nil
        marquee.Visible = false
        if not m or not m.active then return end
        local loc = UIS:GetMouseLocation()
        local lo = Vector2.new(math.min(m.start.X, loc.X), math.min(m.start.Y, loc.Y))
        local hi = Vector2.new(math.max(m.start.X, loc.X), math.max(m.start.Y, loc.Y))
        local cam = workspace.CurrentCamera
        local wholeModels = not UIS:IsKeyDown(Enum.KeyCode.LeftControl)
        local ids, seen = {}, {}
        local function add(id)
            if not seen[id] then
                seen[id] = true
                ids[#ids + 1] = id
            end
        end
        if m.additive then
            for id in pairs(msel) do add(id) end
        end
        for id, e in pairs(all) do
            if e.owner == lp.UserId and e.inst.Parent then
                local v, onScreen = cam:WorldToViewportPoint(e.inst.Position)
                if onScreen and v.Z > 0 and v.X >= lo.X and v.X <= hi.X and v.Y >= lo.Y and v.Y <= hi.Y then
                    if wholeModels then
                        for _, mid in ipairs(expandModel(id)) do add(mid) end
                    else
                        add(id)
                    end
                end
            end
        end
        if #ids == 0 then
            if not m.additive then select_(nil) end
            return
        end
        table.sort(ids)
        selectMany(ids, ids[1])
        play("select")
        if #ids > 1 then toast(#ids .. " parts selected") end
    end

    function toggleInSelection(id)
        local ids = UIS:IsKeyDown(Enum.KeyCode.LeftControl) and { id } or expandModel(id)
        local removing = msel[id]
        for _, i in ipairs(ids) do msel[i] = (not removing) or nil end
        local list = {}
        for k in pairs(msel) do list[#list + 1] = k end
        selectMany(list, (not removing) and id or nil)
    end

    function selectAllMine()
        local ids = {}
        for id, e in pairs(all) do
            if e.owner == lp.UserId then ids[#ids + 1] = id end
        end
        if #ids == 0 then
            toast("You have no parts yet", true)
            return
        end
        table.sort(ids)
        selectMany(ids, ids[1])
        toast("Selected " .. #ids .. " parts")
    end

    local bar = new("Frame", { Name = "SelectionBar", AnchorPoint = Vector2.new(0.5, 0),
        Position = UDim2.new(0.5, 0, 0, 46), Size = UDim2.fromOffset(0, 36), AutomaticSize = Enum.AutomaticSize.X,
        BackgroundColor3 = C.cream, BorderSizePixel = 0, Visible = false }, gui)
    corner(bar, 18)
    stroke(bar, C.edge, 1)
    uiScales[#uiScales + 1] = { u = new("UIScale", {}, bar), base = 1, open = 1, simple = true }
    new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6),
        VerticalAlignment = Enum.VerticalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder }, bar)
    new("UIPadding", { PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 8) }, bar)
    local barLbl = label(bar, "", { Size = UDim2.fromOffset(0, 16), AutomaticSize = Enum.AutomaticSize.X,
        LayoutOrder = 1, Font = Enum.Font.GothamMedium, TextSize = 11 })
    local function barBtn(text, w, order, cb)
        return button(bar, text, cb, { Size = UDim2.fromOffset(w, 26), Order = order, TextSize = 11 })
    end

    function openModelCode()
        local ids = mineSelIds()
        if #ids == 0 then
            toast("Select one of your parts first", true)
            return
        end
        local e = selected and all[selected]
        if not (e and e.owner == lp.UserId) then e = all[ids[1]] end
        if not e.st.mdl then
            if #ids < 2 then
                toast("Group two or more parts into a model first (Ctrl+G)", true)
                return
            end
            groupSelected()
            e = all[ids[1]]
        end
        if e and e.st.mdl then CodeUI.open("model", e.st.mdl) end
    end

    barBtn("Group", 52, 2, groupSelected)
    barBtn("Ungroup", 62, 3, ungroupSelected)
    barBtn("Model code", 80, 4, openModelCode)
    barBtn("Premade", 62, 5, function() openPremades() end)
    barBtn("Duplicate", 68, 6, duplicate)
    barBtn("Delete", 52, 7, deleteSelected)

    refreshSelBar = function()
        local count = selCount()
        local show = editorOpen and count >= 1 and gui.Enabled
        bar.Visible = show and true or false
        if not show then return end
        local e = selected and all[selected]
        local text
        if e and e.st.mdl then
            local members = modelMembers(e.st.mdl)
            text = "Model: " .. tostring(e.st.mname or "Model") .. " (" .. #members .. ")"
            if count > #members then text = text .. "  +" .. (count - #members) end
        else
            text = count == 1 and "1 part" or (count .. " parts")
        end
        barLbl.Text = text
    end

    refreshMultiBoxes = function()
        local count = selCount()
        for id, b in pairs(selBoxes) do
            if count < 2 or not msel[id] or id == selected or not all[id] then
                b:Destroy()
                selBoxes[id] = nil
            else
                b.Adornee = all[id].inst
            end
        end
        if count >= 2 then
            for id in pairs(msel) do
                local e = all[id]
                if e and id ~= selected and not selBoxes[id] then
                    local b = Instance.new("SelectionBox")
                    b.Adornee = e.inst
                    b.LineThickness = 0.04
                    b.Color3 = Color3.fromRGB(0, 190, 255)
                    b.SurfaceColor3 = Color3.fromRGB(0, 190, 255)
                    b.SurfaceTransparency = 0.9
                    b.Visible = gui.Enabled
                    b.Parent = guiParent
                    selBoxes[id] = b
                end
            end
        end
        refreshSelBar()
    end
end

