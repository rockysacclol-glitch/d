uiScales = {}
function applyScale(rec)
    rec.u.Scale = rec.base * (0.9 + 0.1 * rec.open)
end
function newRec(frame, slide)
    local rec = { frame = frame, slide = slide or Vector2.zero, base = 1, open = 0, shown = false, animating = false }
    rec.u = new("UIScale", {}, frame)
    rec.nv = Instance.new("NumberValue")
    rec.nv.Value = 0
    connect(rec.nv.Changed, function(v)
        rec.open = v
        applyScale(rec)
        frame.GroupTransparency = 1 - math.clamp(v, 0, 1)
        if rec.animating and rec.home then
            frame.Position = UDim2.new(rec.home.X.Scale, rec.home.X.Offset + rec.slide.X * (1 - v),
                rec.home.Y.Scale, rec.home.Y.Offset + rec.slide.Y * (1 - v))
        end
    end)
    frame.GroupTransparency = 1
    frame.Visible = false
    applyScale(rec)
    uiScales[#uiScales + 1] = rec
    return rec
end
function showRec(rec, show)
    if rec.shown == show then return end
    rec.shown = show
    local f = rec.frame
    if not rec.animating then rec.home = f.Position end
    rec.animating = true
    if show then f.Visible = true end
    if rec.tw then rec.tw:Cancel() end
    local info = show and TweenInfo.new(0.42, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
        or TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
    local tw = TweenService:Create(rec.nv, info, { Value = show and 1 or 0 })
    rec.tw = tw
    tw.Completed:Connect(function(state)
        if rec.tw ~= tw or state ~= Enum.PlaybackState.Completed then return end
        rec.animating = false
        f.Position = rec.home
        f.GroupTransparency = show and 0 or 1
        if not show then f.Visible = false end
    end)
    tw:Play()
end

