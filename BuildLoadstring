do
    local cfg = CONFIG.Cursors
    local holder = new("Frame", { Name = "Cursor", AnchorPoint = Vector2.new(0.5, 0.5),
        Size = UDim2.fromOffset(38, 38), BackgroundTransparency = 1, ZIndex = 1000, Visible = false }, gui)
    local img = new("ImageLabel", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 1000,
        Visible = false, ScaleType = Enum.ScaleType.Fit }, holder)
    local glyph = new("TextLabel", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "",
        TextScaled = true, Font = Enum.Font.GothamBold, TextColor3 = C.ink, TextStrokeColor3 = C.white,
        TextStrokeTransparency = 0.3, ZIndex = 1000 }, holder)

    local shownTool, curCfg = nil, cfg.select
    local rot, kick, kickV = 0, 0, 0
    local lastLoc, iconHidden = nil, false

    local function skin(t)
        local d = cfg[t] or cfg.select
        curCfg = d
        holder.Size = UDim2.fromOffset(d.size or 34, d.size or 34)
        if d.id and d.id ~= "" then
            img.Image = d.id
            img.Visible, glyph.Visible = true, false
        else
            glyph.Text = d.glyph or "+"
            img.Visible, glyph.Visible = false, true
        end
        shownTool = t
    end

    cursorKick = function()
        kick, kickV = -38, 0
    end

    local function setIconHidden(h)
        if iconHidden == h then return end
        iconHidden = h
        UIS.MouseIconEnabled = not h
    end

    connect(RunService.RenderStepped, function(dt)
        local want = gui.Enabled and editorOpen and not picker.on and not fc.on
        setIconHidden(want)
        holder.Visible = want
        if not want then
            lastLoc = nil
            return
        end
        if tool ~= shownTool then
            skin(tool)
            kick, kickV = -18, 0
        end

        local loc = UIS:GetMouseLocation()
        local vel = lastLoc and (loc - lastLoc) / math.max(dt, 1 / 240) or Vector2.zero
        lastLoc = loc

        local idle = math.sin(os.clock() * 2) * (curCfg.idle or 5)
        local lean = math.clamp(vel.X * 0.02, -30, 30)
        local target = idle + lean
        rot = rot + (target - rot) * (1 - math.exp(-14 * dt))

        kickV += (-kick * 260 - kickV * 14) * dt
        kick += kickV * dt

        holder.Rotation = rot + kick
        local off = curCfg.offset or Vector2.zero
        holder.Position = UDim2.fromOffset(loc.X + off.X, loc.Y + off.Y)
    end)
end

