        if os.clock() - lastClaimRefresh > 15 and myPlot then
            lastClaimRefresh = os.clock()
            sendPlotClaim(myPlot)
            if os.clock() - (lastScriptResend or 0) > 90 then
                lastScriptResend = os.clock()
                local list = plotScripts[myPlot.key]
                if list then
                    for idx, rec in pairs(list) do
                        publish({ u = lp.UserId, n = lp.Name, o = { { k = "ps", plot = myPlot.key, idx = idx, n = rec.n, src = rec.src } } })
                    end
                end
            end
        end
        if os.clock() - lastScriptSync >= 0.75 then
            lastScriptSync = os.clock()
            Scripts.syncAll()
        end
    end
end)

