function plotOverride(key, field)
    local t = key and plotOverrides[key]
    if not t then return nil end
    for _, o in pairs(t) do
        if o[field] ~= nil then return o[field] end
    end
    return nil
end

-- Lighting and gravity for a plot: saved world settings first, then whatever its scripts are driving.
function applyPlotLighting(key)
    local settings = key and plotWorldSettings[key]
    local ovs = key and plotOverrides[key]
    local hasOv = ovs ~= nil and next(ovs) ~= nil
    if key and (settings or hasOv) then
        local s = settings or {}
        local function bounded(value, fallback, minimum, maximum)
            local number = tonumber(value)
            if not number or number ~= number or number == math.huge or number == -math.huge then
                return fallback
            end
            return math.clamp(number, minimum, maximum)
        end
        local function pick(field, value, fallback, lo, hi)
            local o = plotOverride(key, field)
            if o ~= nil then return o end
            return bounded(value, fallback, lo, hi)
        end
        local function pickC(field, fallback)
            local o = plotOverride(key, field)
            if o ~= nil then return o end
            return fallback
        end
        workspace.Gravity = pick("gravity", s.gravity, originalWorld.gravity, 0, 1000)
        Lighting.Brightness = pick("brightness", s.brightness, originalWorld.brightness, 0, 10)
        Lighting.ClockTime = pick("clockTime", s.clockTime, originalWorld.clockTime, 0, 24)
        Lighting.FogEnd = pick("fogEnd", s.fogEnd, originalWorld.fogEnd, 0, 100000)
        Lighting.FogStart = pick("fogStart", nil, originalWorld.fogStart, 0, 100000)
        Lighting.FogColor = pickC("fogColor", originalWorld.fogColor)
        Lighting.Ambient = pickC("ambient", originalWorld.ambient)
        Lighting.OutdoorAmbient = pickC("outdoorAmbient", originalWorld.outdoorAmbient)
        Lighting.ExposureCompensation = pick("exposure", nil, originalWorld.exposure, -3, 3)
    else
        workspace.Gravity = originalWorld.gravity
        Lighting.Brightness = originalWorld.brightness
        Lighting.ClockTime = originalWorld.clockTime
        Lighting.FogEnd = originalWorld.fogEnd
        Lighting.FogStart = originalWorld.fogStart
        Lighting.FogColor = originalWorld.fogColor
        Lighting.Ambient = originalWorld.ambient
        Lighting.OutdoorAmbient = originalWorld.outdoorAmbient
        Lighting.ExposureCompensation = originalWorld.exposure
    end
end

appliedPlotKey = nil
function applyPlotWorld(key)
    if key ~= appliedPlotKey then
        appliedPlotKey = key
        if key then Music.manualStop = false end
    end
    local settings = key and plotWorldSettings[key]
    applyPlotLighting(key)
    if key and settings then
